@page "/stats"
@attribute [Authorize]
@inject NavigationManager Navigation

@* The statistics now live on the profile page ("Mes statistiques"). This route only forwards, so that
   existing links and bookmarks keep working. It renders nothing, and replaces its history entry so that
   Back does not bounce the visitor straight back here. *@

@code {
    protected override void OnInitialized() => Navigation.NavigateTo("/profil", replace: true);
}
