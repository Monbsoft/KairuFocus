@page "/dashboard"
@attribute [Authorize]
@using KairuFocus.Web.Components.Dashboard
@inject AuthService AuthService
@inject CommunityFormatter F
@inject TimeProvider Clock

<PageTitle>@F["Dashboard.PageTitle"]</PageTitle>

<div class="kf-dash">
    <div class="kf-dash__head">
        @if (_userName is null)
        {
            <div class="kf-skel kf-dash__skel-greet" aria-hidden="true"></div>
        }
        else
        {
            <h1 class="kf-dash__greet">@F.Format("Dashboard.Greeting", _userName)</h1>
        }
        <p class="kf-dash__date">@_today</p>
    </div>

    <PomodoroPanel />

    <TodayJournalPanel />
</div>

@code {
    private string? _userName;
    private string _today = "";

    protected override async Task OnInitializedAsync()
    {
        _today = CommunityFormatter.Capitalize(F.WeekdayDayMonth(DateOnly.FromDateTime(Clock.GetLocalNow().DateTime)));

        var user = await AuthService.GetCurrentUserAsync();
        _userName = user.FindFirst("name")?.Value
            ?? user.FindFirst("login")?.Value
            ?? "dev";
    }
}
