@page "/pomodoro"
@attribute [Authorize]
@using KairuFocus.Web.Services
@inject PomodoroApiClient PomodoroApi
@inject TaskApiClient TaskApi
@inject SettingsApiClient SettingsApi
@inject CommunityApiClient CommunityApi
@inject CommunityFormatter F
@inject ISoundService SoundService
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="d-flex align-items-center justify-content-between mb-1">
    <h2 class="mb-0">Pomodoro</h2>
    <div style="position:relative">
        <button class="btn-more" @onclick="ToggleMoreMenu" title="Plus d'options">&#xB7;&#xB7;&#xB7;</button>
        @if (_moreMenuOpen)
        {
            <div class="dropdown-menu-simple">
                <button @onclick="NavigateToSprintLibre">Sprint libre</button>
            </div>
        }
    </div>
</div>

@if (!_loaded)
{
    <p>Chargement…</p>
}
else
{
    <div class="d-flex flex-column align-items-center gap-3">

        <!-- Sélection du type de session (onglets) -->
        @if (_session is null || _session.Status is "Completed" or "Interrupted")
        {
            <div class="btn-group mb-3" role="group" aria-label="Type de session">
                <input type="radio" class="btn-check" name="sessionType" id="typeSprint" value="Sprint" 
                       checked="@(_selectedSessionType == "Sprint")" @onchange="@(e => SelectSessionType("Sprint"))">
                <label class="btn btn-outline-primary" for="typeSprint">
                    🍅 Sprint (@_sprintDuration min)
                </label>

                <input type="radio" class="btn-check" name="sessionType" id="typeShortBreak" value="ShortBreak" 
                       checked="@(_selectedSessionType == "ShortBreak")" @onchange="@(e => SelectSessionType("ShortBreak"))">
                <label class="btn btn-outline-success" for="typeShortBreak">
                    ☕ Pause courte (@_shortBreakDuration min)
                </label>

                <input type="radio" class="btn-check" name="sessionType" id="typeLongBreak" value="LongBreak" 
                       checked="@(_selectedSessionType == "LongBreak")" @onchange="@(e => SelectSessionType("LongBreak"))">
                <label class="btn btn-outline-info" for="typeLongBreak">
                    🌙 Pause longue (@_longBreakDuration min)
                </label>
            </div>
        }

        <!-- Horloge circulaire -->
        <svg viewBox="0 0 220 220" width="220" height="220" style="overflow:visible">
            <!-- Cercle de fond -->
            <circle cx="110" cy="110" r="95"
                    fill="none"
                    stroke="#e9ecef"
                    stroke-width="14" />
            <!-- Arc de progression -->
            <circle cx="110" cy="110" r="95"
                    fill="none"
                    stroke="@ArcColor"
                    stroke-width="14"
                    stroke-linecap="round"
                    stroke-dasharray="@_circumference.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                    stroke-dashoffset="@DashOffset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                    transform="rotate(-90 110 110)"
                    style="transition: stroke-dashoffset 0.8s linear, stroke 0.4s ease;" />
            <!-- Temps restant -->
            <text x="110" y="105"
                  text-anchor="middle"
                  dominant-baseline="middle"
                  font-size="42"
                  font-family="monospace"
                  fill="currentColor">
                @TimeDisplay
            </text>
            <!-- Statut -->
            <text x="110" y="148"
                  text-anchor="middle"
                  font-size="15"
                  fill="#6c757d">
                @StatusLabel
            </text>
        </svg>

        <!-- Boutons de contrôle -->
        <div class="d-flex gap-2">
            @if (_session is null || _session.Status is "Completed" or "Interrupted")
            {
                <button class="btn btn-primary btn-lg" @onclick="StartSession" disabled="@_starting">
                    @(_starting ? "Démarrage…" : "▶ Démarrer")
                </button>
            }
            else if (_session.Status == "Active")
            {
                if (_completionFailed)
                {
                    <button class="btn btn-primary btn-lg" @onclick="CompleteSession" disabled="@_completing">
                        @(_completing ? "Nouvelle tentative…" : "↻ Réessayer")
                    </button>
                }
                <button class="btn btn-outline-warning btn-lg" @onclick="InterruptSession" disabled="@_completing">
                    ⏹ Interrompre
                </button>
            }
        </div>

        <!-- Sprint partagé : avec qui je suis, et ouverture du groupe (sprint minuté actif d'un membre de la communauté) -->
        @if (_isMember && _session is { Status: "Active", SessionType: "Sprint" })
        {
            <SprintParticipants />
        }

        @if (CanManageGroup)
        {
            <div class="d-flex flex-column align-items-center gap-1 text-center" style="max-width:480px">
                @* aria-disabled rather than disabled during the call: the keyboard focus stays on the button (the handler ignores a second click). *@
                <button type="button" class="btn btn-sm btn-outline-secondary @(_closingGroup ? "disabled" : "")"
                        aria-describedby="group-closed-hint"
                        aria-disabled="@(_closingGroup ? "true" : null)"
                        @onclick="ToggleGroupClosed">
                    @F[_session!.IsClosedToJoin ? "Participants.Reopen" : "Participants.Close"]
                </button>
                <small id="group-closed-hint" class="text-body-secondary">
                    @F[_session!.IsClosedToJoin ? "Participants.Reopen.Hint" : "Participants.Close.Hint"]
                </small>
            </div>
        }

        @* Group break (UC-CO-10): started by the server at the end of a shared sprint, with a shared end for everyone *@
        @if (_session is { Status: "Active", SharedEndAt: not null } && _session.SessionType != "Sprint")
        {
            <small role="status" class="text-body-secondary text-center" style="max-width:480px">@F["Participants.GroupBreak"]</small>
        }

        <!-- Résultat après fin de session -->
        @if (_completedSessionType is not null)
        {
            var (icon, label, next) = _completedSessionType switch
            {
                "Sprint"     => ("🍅", "Sprint terminé !",      _suggestedNextSessionType switch { "LongBreak" => "Pause recommandée : longue", "ShortBreak" => "Pause recommandée : courte", _ => "" }),
                "ShortBreak" => ("☕", "Pause courte terminée !", "Sprint recommandé !"),
                "LongBreak"  => ("🌙", "Pause longue terminée !", "Sprint recommandé !"),
                _            => ("✅", "Session terminée !",       "")
            };
            <div class="alert alert-success text-center" style="max-width:360px">
                @icon @label <strong>@next</strong>
            </div>
        }

        <!-- Tâches liées au sprint actif — masqué pendant une pause -->
        @if (_session?.Status == "Active" && _session.SessionType == "Sprint")
        {
            <div style="width:100%;max-width:480px">
                <h5 class="mb-2">Tâches du sprint</h5>

                @if (_linkedTasks.Count > 0)
                {
                    <ul class="list-group mb-3">
                        @foreach (var task in _linkedTasks)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex gap-2 align-items-center">
                                    <span class="@(task.Status == "Done" ? "text-decoration-line-through text-muted" : "")">
                                        @task.Title
                                    </span>
                                    @if (task.Tags is { Count: > 0 })
                                    {
                                        <span class="badge bg-light text-dark border">@task.Tags[0]</span>
                                    }
                                </span>
                                <span class="d-flex gap-2 align-items-center">
                                    <span class="badge @BadgeClass(task.Status)">@task.Status</span>
                                    @if (task.Status == "Pending")
                                    {
                                        <button class="btn btn-sm btn-outline-primary"
                                                title="Marquer @task.Title en cours"
                                                aria-label="Marquer la tâche @task.Title comme en cours"
                                                @onclick="() => SetTaskInProgress(task.Id)">
                                            En cours
                                        </button>
                                    }
                                    @if (task.Status != "Done")
                                    {
                                        <button class="btn btn-sm btn-success"
                                                title="Terminer @task.Title"
                                                aria-label="Terminer la tâche @task.Title"
                                                @onclick="() => CompleteLinkedTask(task.Id)">
                                            ✓
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger"
                                            title="Retirer @task.Title du sprint"
                                            aria-label="Retirer la tâche @task.Title du sprint"
                                            @onclick="() => UnlinkTask(task.Id)">
                                        ✕
                                    </button>
                                </span>
                            </li>
                        }
                    </ul>
                }

                <!-- Lier une tâche existante -->
                <div class="mb-2">
                    <select class="form-select form-select-sm" @bind="_selectedTaskIdToLink">
                        <option value="">— Lier une tâche existante —</option>
                        @foreach (var task in GetLinkableTasks())
                        {
                            <option value="@task.Id">@FormatTaskOption(task)</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-outline-secondary mt-1"
                            disabled="@string.IsNullOrEmpty(_selectedTaskIdToLink)"
                            @onclick="LinkExistingTask">
                        Lier
                    </button>
                </div>

                <!-- Créer une nouvelle tâche -->
                <div class="d-flex gap-2">
                    <input class="form-control form-control-sm"
                           placeholder="Nouvelle tâche pendant le sprint…"
                           @bind="_newTaskTitle"
                           @bind:event="oninput"
                           @onkeydown="OnNewTaskKeyDown" />
                    <button class="btn btn-sm btn-primary"
                            disabled="@string.IsNullOrWhiteSpace(_newTaskTitle)"
                            @onclick="CreateTask">
                        +
                    </button>
                </div>
            </div>
        }

        @if (_infoMessage is not null)
        {
            <div class="alert alert-info" role="status" style="max-width:480px">@_infoMessage</div>
        }

        @if (_errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert" style="max-width:480px">@_errorMessage</div>
        }
    </div>
}

<XpToast @ref="_xpToast" />

@code {
    // ── Constantes SVG ─────────────────────────────────────────────────────
    private const double Radius = 95.0;
    private readonly double _circumference = 2 * Math.PI * Radius;

    // ── Menu contextuel ───────────────────────────────────────────────────
    private bool _moreMenuOpen;

    private void ToggleMoreMenu() => _moreMenuOpen = !_moreMenuOpen;

    private void NavigateToSprintLibre()
    {
        _moreMenuOpen = false;
        Nav.NavigateTo("/pomodoro/libre");
    }

    // ── État ──────────────────────────────────────────────────────────────
    private bool _loaded;
    private PomodoroSessionDto? _session;
    private string? _completedSessionType;
    private string? _suggestedNextSessionType;
    private List<TaskDto> _allTasks = [];
    private List<TaskDto> _linkedTasks = [];
    private string? _errorMessage;
    private string? _infoMessage;
    private bool _starting;
    private bool _completing;       // a completion request is in flight (blocks double submit)
    private bool _completionFailed; // the last completion failed and the session may still be active: offer "Réessayer"
    private string _newTaskTitle = string.Empty;
    private string _selectedTaskIdToLink = string.Empty;
    private XpToast? _xpToast;

    // ── Shared sprint (community) ─────────────────────────────────────────
    private bool _isMember;      // read once, without blocking the page; a failure means "not a member" (no button)
    private bool _closingGroup;  // a close/reopen request is in flight
    private bool _disposed;

    /// <summary>"Fermer / Rouvrir ce sprint": only the host of a timed sprint, and only when a community member.
    /// A free sprint never reaches <c>_session</c> (see <see cref="TryAdoptTimedSession"/>), so it never shows it.</summary>
    private bool CanManageGroup =>
        _isMember && _session is { Status: "Active", SessionType: "Sprint", IsGroupHost: true };

    // ── Session type selection ────────────────────────────────────────────
    private string _selectedSessionType = "Sprint";
    private int _sprintDuration = 25;
    private int _shortBreakDuration = 5;
    private int _longBreakDuration = 15;
    private string _ringtonePreference = "AlarmClock";
    private int _alarmVolume = 80;

    // ── Timer ─────────────────────────────────────────────────────────────
    private int _remainingSeconds;
    private int _totalSeconds;
    private DateTime? _deadlineUtc; // StartedAt + planned duration, compared with the device clock
    private CancellationTokenSource? _timerCts;

    // ── Computed ──────────────────────────────────────────────────────────
    private string TimeDisplay =>
        _remainingSeconds >= 0
            ? $"{_remainingSeconds / 60:D2}:{_remainingSeconds % 60:D2}"
            : "00:00";

    private string StatusLabel => _session?.Status switch
    {
        "Active" => _session.SessionType switch
        {
            "Sprint" => "Sprint en cours",
            "ShortBreak" => "Pause courte",
            "LongBreak" => "Pause longue",
            _ => "En cours"
        },
        "Completed"   => "Terminé",
        "Interrupted" => "Interrompu",
        _             => "Prêt"
    };

    private string ArcColor => _session?.Status switch
    {
        "Active" => _session.SessionType switch
        {
            "Sprint" => "#0d6efd",      // Bleu pour sprint
            "ShortBreak" => "#198754",  // Vert pour pause courte
            "LongBreak" => "#0dcaf0",   // Cyan pour pause longue
            _ => "#0d6efd"
        },
        "Completed"   => "#198754",
        "Interrupted" => "#ffc107",
        _             => "#adb5bd"
    };

    private double DashOffset
    {
        get
        {
            if (_totalSeconds <= 0 || _session?.Status != "Active")
                return 0;
            var progress = Math.Clamp((double)_remainingSeconds / _totalSeconds, 0, 1);
            return _circumference * (1 - progress);
        }
    }

    private IEnumerable<TaskDto> GetLinkableTasks() =>
        _allTasks.Where(t =>
            t.Status != "Done" &&
            (_session is null || !_session.LinkedTaskIds.Contains(t.Id)));

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Started first and not awaited: it must never delay the page (see LoadMembershipAsync).
        _ = LoadMembershipAsync();

        // None of the secondary loads below may keep the page on "Chargement…" or prevent a running
        // session from being resumed: each failure is absorbed and falls back to the field defaults.
        try
        {
            _allTasks = await TaskApi.GetAllAsync();
        }
        catch (Exception ex) when (IsApiCallFailure(ex))
        {
            // The task list is the only fallback the user can see (linking tasks), so tell them.
            _allTasks = [];
            _errorMessage = "Impossible de charger les tâches.";
        }

        _session  = await PomodoroApi.GetCurrentSessionAsync();

        // Load suggested session type and durations (silent fallback to the field defaults)
        var suggested = await GetSuggestedSessionTypeOrNullAsync();
        if (suggested is not null)
        {
            _selectedSessionType = suggested.SuggestedType;
            _sprintDuration = suggested.SprintDurationMinutes;
            _shortBreakDuration = suggested.ShortBreakDurationMinutes;
            _longBreakDuration = suggested.LongBreakDurationMinutes;
        }

        // Settings only drive the ringtone and volume here: silent fallback to the field defaults.
        UserSettingsDto? userSettings = null;
        try
        {
            userSettings = await SettingsApi.GetSettingsAsync();
        }
        catch (Exception ex) when (IsApiCallFailure(ex)) { }

        if (userSettings is not null)
        {
            _ringtonePreference = userSettings.RingtonePreference;
            _alarmVolume = userSettings.AlarmVolume;
        }

        if (_session?.Status == "Active" && TryAdoptTimedSession(_session))
        {
            await StartTimerLoop();
        }

        RefreshLinkedTasks();
        _loaded = true;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_timerCts is not null)
        {
            await _timerCts.CancelAsync();
            _timerCts.Dispose();
        }
    }

    /// <summary>Reads whether I am a community member. Any failure leaves <c>_isMember</c> false: no button, no list.</summary>
    private async Task LoadMembershipAsync()
    {
        try
        {
            var membership = await CommunityApi.GetMembershipAsync();
            if (_disposed) return;

            _isMember = membership?.IsMember == true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Accessory: the page works without it.
        }
    }

    // ── Actions ───────────────────────────────────────────────────────────
    /// <summary>Closes or reopens my group to new arrivals. The countdown is left alone: only the session
    /// flag changes, so the page reads the session again without touching the timer.</summary>
    private async Task ToggleGroupClosed()
    {
        if (_closingGroup || _session is not { } current) return;
        _closingGroup = true;
        _errorMessage = null;

        try
        {
            var close = !current.IsClosedToJoin;
            if (!await CommunityApi.SetSprintClosedAsync(close))
            {
                _errorMessage = F["Participants.Close.Error"];
                return;
            }

            // Reload the session; if the read fails the server did accept the change, so apply it locally
            // rather than wipe the running session from the screen.
            var fresh = await PomodoroApi.GetCurrentSessionAsync();
            _session = fresh is { Status: "Active" }
                ? fresh
                : current with { IsClosedToJoin = close };
        }
        catch (Exception)
        {
            _errorMessage = F["Participants.Close.Error"];
        }
        finally
        {
            _closingGroup = false;
        }
    }

    private void SelectSessionType(string sessionType)
    {
        _selectedSessionType = sessionType;
        StateHasChanged();
    }

    private async Task StartSession()
    {
        if (_starting) return;
        _starting = true;
        _errorMessage = null;
        _infoMessage = null;
        _completedSessionType = null;
        _suggestedNextSessionType = null;
        _completionFailed = false;
        StateHasChanged();

        try
        {
            var outcome = await PomodoroApi.StartSessionAsync(_selectedSessionType);
            if (outcome.Session is null)
            {
                // The POST may have actually succeeded server-side even though we see no
                // session here (HTTP timeout on the way back, or a 409 raised by our own
                // earlier attempt once the 5s server idempotency window has elapsed).
                // Resync with the server before surfacing an error, so the user never gets
                // stuck on an errored screen while a session is genuinely running.
                var current = await PomodoroApi.GetCurrentSessionAsync();
                if (current?.Status == "Active")
                {
                    if (TryAdoptTimedSession(current))
                    {
                        if (current.SessionType != _selectedSessionType)
                        {
                            // The resync recovered a different session type than the one the
                            // user just asked for (e.g. an interrupted attempt actually landed
                            // as a break). Adopting it silently would leave the tab selector out
                            // of sync with no explanation — surface it instead.
                            _infoMessage = $"Une session « {SessionTypeLabel(current.SessionType)} » était déjà en cours ; on l'a reprise.";
                            _selectedSessionType = current.SessionType;
                        }

                        RefreshLinkedTasks();
                        await StartTimerLoop();
                    }

                    return;
                }

                _errorMessage = outcome.Error ?? "Impossible de démarrer la session.";
                return;
            }

            if (TryAdoptTimedSession(outcome.Session))
            {
                RefreshLinkedTasks();
                await StartTimerLoop();
            }
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task InterruptSession()
    {
        _errorMessage = null;
        await StopTimer();

        var ok = await PomodoroApi.InterruptSessionAsync();
        if (!ok)
        {
            _errorMessage = "Impossible d'interrompre le sprint.";
            return;
        }

        _session = await PomodoroApi.GetCurrentSessionAsync();
        _completedSessionType = null;
        _completionFailed = false;
        RefreshLinkedTasks();
    }

    private async Task OnTimerCompleted()
    {
        // The ringtone plays once, at expiry. Retries ("Réessayer") call CompleteSession directly,
        // which skips it. The ringtone is accessory (JS interop can fail, e.g. script not loaded):
        // a failure here must never prevent the session from being completed.
        try
        {
            await SoundService.PlayRingtoneAsync(_ringtonePreference, _alarmVolume);
        }
        catch (Exception) { }

        await CompleteSession();
    }

    /// <summary>Completes the active session. Runs from the timer loop (via <c>InvokeAsync</c>) and
    /// from the "Réessayer" button, so every state change is followed by an explicit
    /// <c>StateHasChanged()</c>. A failed attempt never leaves the page stuck: see
    /// <see cref="RecoverFromFailedCompletionAsync"/>. An unexpected exception is turned into the
    /// same recoverable failure state here rather than in the timer loop's catch-all, which also
    /// covers mid-countdown ticks where "Réessayer" would mean a premature end.</summary>
    private async Task CompleteSession()
    {
        if (_completing) return;
        _completing = true;
        _errorMessage = null;
        _infoMessage = null;
        StateHasChanged();

        try
        {
            var completedType = _session?.SessionType;
            var xpAwarded = await PomodoroApi.CompleteSessionAsync();
            if (xpAwarded is null)
            {
                await RecoverFromFailedCompletionAsync();
                return;
            }

            _completionFailed = false;
            _completedSessionType = completedType;
            _session = await PomodoroApi.GetCurrentSessionAsync();
            _remainingSeconds = 0;

            var suggested = await GetSuggestedSessionTypeOrNullAsync();
            _suggestedNextSessionType = suggested?.SuggestedType;
            if (suggested is not null)
                _selectedSessionType = suggested.SuggestedType;

            RefreshLinkedTasks();
            StateHasChanged();

            if (xpAwarded.Value > 0 && _xpToast is not null)
                _ = _xpToast.ShowAsync(xpAwarded.Value);

            // The sprint is recorded and credited: the group break is a bonus that never turns this into a failure.
            if (completedType == "Sprint")
                await TryFollowGroupBreakAsync();
        }
        catch (Exception)
        {
            // Unexpected failure: don't surface ex.Message, offer "Réessayer" instead.
            _completionFailed = true;
            _errorMessage = "Impossible de terminer la session. Réessaie.";
        }
        finally
        {
            _completing = false;
            StateHasChanged();
        }
    }

    /// <summary>After a finished sprint, asks the server for the group break; when one started, shows its countdown
    /// instead of the "Sprint terminé" banner. Any failure leaves the screen as the completion left it, with no error:
    /// the sprint itself is already recorded.</summary>
    private async Task TryFollowGroupBreakAsync()
    {
        try
        {
            if (!await CommunityApi.StartGroupBreakAsync()) return;

            var current = await PomodoroApi.GetCurrentSessionAsync();
            if (current is not { Status: "Active" } || !TryAdoptTimedSession(current)) return;

            _selectedSessionType = current.SessionType;
            _completedSessionType = null;
            _suggestedNextSessionType = null;
            RefreshLinkedTasks();
            await StartTimerLoop();
        }
        catch (Exception)
        {
            // Accessory: the "Sprint terminé" screen stays.
        }
    }

    /// <summary>Called after a failed completion request. Asks the server what became of the
    /// session. If it is gone (204 — e.g. completed from another tab, so our request got a 400),
    /// the page goes back to "Prêt" with an informational message: we can't know what was credited,
    /// so no "Sprint terminé !" banner and no XP toast. If it is still active, or the server can't
    /// be reached, the page shows an error and offers "Réessayer" (no automatic retry loop);
    /// "Interrompre" stays available.</summary>
    private async Task RecoverFromFailedCompletionAsync()
    {
        var lookup = await PomodoroApi.LookupCurrentSessionAsync();

        if (lookup.Succeeded && lookup.Session is null)
        {
            _session = null;
            _completionFailed = false;
            _completedSessionType = null;
            _suggestedNextSessionType = null;
            _remainingSeconds = 0;
            _totalSeconds = 0;
            _infoMessage = "Cette session n'est plus active (elle a peut-être été terminée depuis un autre onglet).";
            RefreshLinkedTasks();
            return;
        }

        _completionFailed = true;
        _errorMessage = lookup.Unauthorized
            ? "Ta session a expiré, reconnecte-toi."
            : lookup.Succeeded
                ? "Impossible de terminer la session. Réessaie."
                : "Serveur injoignable, vérifie ta connexion puis réessaie.";
    }

    private async Task LinkExistingTask()
    {
        if (!Guid.TryParse(_selectedTaskIdToLink, out var id)) return;
        _errorMessage = null;

        var ok = await PomodoroApi.LinkTaskAsync(id);
        if (!ok) { _errorMessage = "Impossible de lier la tâche."; return; }

        _session = await PomodoroApi.GetCurrentSessionAsync();
        _selectedTaskIdToLink = string.Empty;
        RefreshLinkedTasks();
    }

    private async Task CreateTask()
    {
        if (string.IsNullOrWhiteSpace(_newTaskTitle)) return;
        _errorMessage = null;

        var created = await PomodoroApi.CreateTaskDuringSessionAsync(_newTaskTitle.Trim());
        if (created is null) { _errorMessage = "Impossible de créer la tâche."; return; }

        _allTasks.Add(created);
        _session = await PomodoroApi.GetCurrentSessionAsync();
        _newTaskTitle = string.Empty;
        RefreshLinkedTasks();
    }

    private async Task SetTaskInProgress(Guid taskId)
    {
        _errorMessage = null;
        var updated = await PomodoroApi.UpdateTaskStatusAsync(taskId, "InProgress");
        if (updated is null) { _errorMessage = "Impossible de mettre à jour le statut."; return; }
        UpdateLocalTask(updated);
    }

    private async Task UnlinkTask(Guid taskId)
    {
        _errorMessage = null;
        var ok = await PomodoroApi.UnlinkTaskAsync(taskId);
        if (!ok) { _errorMessage = "Impossible de retirer la tâche du sprint."; return; }

        _session = await PomodoroApi.GetCurrentSessionAsync();
        RefreshLinkedTasks();
    }

    private async Task CompleteLinkedTask(Guid taskId)
    {
        _errorMessage = null;
        var updated = await PomodoroApi.UpdateTaskStatusAsync(taskId, "Done");
        if (updated is null) { _errorMessage = "Impossible de compléter la tâche."; return; }
        UpdateLocalTask(updated);
    }

    private async Task OnNewTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newTaskTitle))
            await CreateTask();
    }

    /// <summary>Wires the local countdown-timer state onto a session reported as Active by the
    /// server, unless it's a free sprint (<c>PlannedDurationMinutes == 0</c>). Free sprints carry
    /// no planned duration, so <see cref="InitTimer"/> would compute <c>_totalSeconds = 0</c> and
    /// the timer loop would complete — and close — the session on its very first tick. This is the
    /// single choke point for every path on this page that can discover an active session: initial
    /// load, a successful start, and the resync after an ambiguous start response. Returns
    /// <c>true</c> when a timed session was adopted (the caller must then start the timer loop);
    /// <c>false</c> when the active session was a free sprint — <c>_session</c> is cleared and
    /// <c>_infoMessage</c> invites the user to rejoin it from the Sprint libre screen instead.
    /// </summary>
    private bool TryAdoptTimedSession(PomodoroSessionDto session)
    {
        if (session.PlannedDurationMinutes == 0)
        {
            _session = null;
            _infoMessage = "Un sprint libre est déjà en cours. Rejoins-le depuis « Sprint libre ».";
            return false;
        }

        _session = session;
        InitTimer(session);
        return true;
    }

    private static string SessionTypeLabel(string sessionType) => sessionType switch
    {
        "Sprint" => "Sprint",
        "ShortBreak" => "Pause courte",
        "LongBreak" => "Pause longue",
        _ => sessionType
    };

    // ── Timer internals ───────────────────────────────────────────────────
    private void InitTimer(PomodoroSessionDto session)
    {
        if (session.SharedEndAt is { } sharedEnd)
        {
            // A sprint joined from a group: everyone ends at the same instant, so the deadline is the shared end and
            // the total is what remained when this session started (at least 1: the ring divides by it).
            _deadlineUtc = sharedEnd;
            _totalSeconds = Math.Max(1, (int)Math.Ceiling((sharedEnd - (session.StartedAt ?? DateTime.UtcNow)).TotalSeconds));
        }
        else
        {
            _totalSeconds = session.PlannedDurationMinutes * 60;
            // No StartedAt should not happen on an Active session: fall back to "starts now".
            _deadlineUtc = (session.StartedAt ?? DateTime.UtcNow).AddSeconds(_totalSeconds);
        }

        _remainingSeconds = ComputeRemainingSeconds();
    }

    // Recomputed from the deadline at every tick, so a late tick (throttled tab) has no lasting effect.
    // Ceiling: zero only once the deadline is really reached; clamp: a slow device clock never shows more than the total.
    // Math.Max on the upper bound: Math.Clamp throws when max < min, and the duration comes from the server.
    private int ComputeRemainingSeconds() =>
        _deadlineUtc is { } deadline
            ? Math.Clamp((int)Math.Ceiling((deadline - DateTime.UtcNow).TotalSeconds), 0, Math.Max(0, _totalSeconds))
            : 0;

    private async Task StartTimerLoop()
    {
        await StopTimer();
        _timerCts = new CancellationTokenSource();
        var token = _timerCts.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            try
            {
                // Check first, wait after: an already-expired session is completed right away.
                do
                {
                    _remainingSeconds = ComputeRemainingSeconds();
                    await InvokeAsync(StateHasChanged);

                    if (_remainingSeconds <= 0)
                    {
                        await InvokeAsync(OnTimerCompleted);
                        break;
                    }
                }
                while (await timer.WaitForNextTickAsync(token));
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = $"Erreur de fin de session : {ex.Message}";
                    StateHasChanged();
                });
            }
        }, token);
    }

    private async Task StopTimer()
    {
        if (_timerCts is not null)
        {
            await _timerCts.CancelAsync();
            _timerCts.Dispose();
            _timerCts = null;
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────
    /// <summary>True for the exceptions an API call can raise on a non-2xx status
    /// (<c>GetFromJsonAsync</c>), a network error, a timeout or an unparsable body.</summary>
    private static bool IsApiCallFailure(Exception ex) =>
        ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException;

    /// <summary><c>GetSuggestedSessionTypeAsync</c> throws on a network error (unlike on a non-2xx
    /// status, where it returns null). The suggestion is only a convenience, so a failure falls
    /// back to <c>null</c>.</summary>
    private async Task<SuggestedSessionTypeDto?> GetSuggestedSessionTypeOrNullAsync()
    {
        try
        {
            return await PomodoroApi.GetSuggestedSessionTypeAsync();
        }
        catch (Exception ex) when (IsApiCallFailure(ex))
        {
            return null;
        }
    }

    private void RefreshLinkedTasks()
    {
        if (_session is null) { _linkedTasks = []; return; }
        var ids = _session.LinkedTaskIds.ToHashSet();
        _linkedTasks = _allTasks.Where(t => ids.Contains(t.Id)).ToList();
    }

    private void UpdateLocalTask(TaskDto updated)
    {
        var idx = _allTasks.FindIndex(t => t.Id == updated.Id);
        if (idx >= 0) _allTasks[idx] = updated;
        RefreshLinkedTasks();
    }

    private static string FormatTaskOption(TaskDto task) =>
        task.Tags is { Count: > 0 }
            ? $"[{task.Tags[0]}] {task.Title}"
            : task.Title;

    private static string BadgeClass(string status) => status switch
    {
        "Done"       => "bg-success",
        "InProgress" => "bg-warning text-dark",
        _            => "bg-secondary"
    };
}
