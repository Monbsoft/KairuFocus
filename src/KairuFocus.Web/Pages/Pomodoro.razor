@page "/pomodoro"
@attribute [Authorize]
@using KairuFocus.Web.Services
@inject PomodoroApiClient PomodoroApi
@inject TaskApiClient TaskApi
@inject SettingsApiClient SettingsApi
@inject CommunityApiClient CommunityApi
@inject CommunityFormatter F
@inject ISoundService SoundService
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="d-flex align-items-center justify-content-between mb-1">
    <h2 class="mb-0">Pomodoro</h2>
    @* No free sprint in a group session (its steps are timed): the menu only holds it, so it goes away meanwhile. *@
    @if (!IsGroupLive)
    {
        <div style="position:relative">
            <button class="btn-more" @onclick="ToggleMoreMenu" title="Plus d'options">&#xB7;&#xB7;&#xB7;</button>
            @if (_moreMenuOpen)
            {
                <div class="dropdown-menu-simple">
                    <button @onclick="NavigateToSprintLibre">Sprint libre</button>
                </div>
            }
        </div>
    }
</div>

@* Always mounted, so that what is set later is announced: a new step of the group, the wait, the end of the group.
   Never the countdown. *@
<div class="visually-hidden" role="status" aria-live="polite">@_groupAnnouncement</div>

@if (!_loaded)
{
    <p>Chargement…</p>
}
else
{
    <div class="d-flex flex-column align-items-center gap-3">

        <!-- Fin du groupe : la raison, le bilan et la Communauté, au-dessus de l'écran habituel (jusqu'au prochain démarrage) -->
        @if (_groupEnd is { } end)
        {
            <div class="alert alert-info kf-group-ended mb-0">
                <strong>@end.Reason</strong>
                @if (end.SprintsTogether > 0)
                {
                    <span>@F.Plural("Profile.Status.Together", end.SprintsTogether, F.Number(end.SprintsTogether))</span>
                }
                <a class="alert-link" href="communaute">@F["Group.Ended.Community"]</a>
            </div>
        }

        <!-- Session de groupe : la bande au-dessus du minuteur, pendant l'étape et l'attente -->
        @if (IsGroupLive)
        {
            <GroupSessionLine Group="_group!" />
            @if (_groupFailures >= MaxSilentGroupFailures)
            {
                <p class="kf-group-note mb-0">@F["Group.Error"]</p>
            }
        }

        <!-- Ambiance du bureau (#50) : celle de l'hôte, pour l'hôte et ceux qui sont assis chez lui -->
        @if (_group is { Ambiance: { } ambiance } && _group.Phase != "Ended" && AmbianceHostName is { } ambianceHost)
        {
            <AmbianceLink Ambiance="ambiance" HostName="@ambianceHost" />
        }

        @if (IsHostWaiting)
        {
            <p class="kf-group-yourturn mb-0">@F["Group.YourTurn.Title"]</p>
        }

        <!-- Sélection du type de session (onglets) : jamais pour un participant, qui suit l'hôte -->
        @if (ShowTypeTabs)
        {
            <div class="btn-group mb-3" role="group" aria-label="Type de session">
                <input type="radio" class="btn-check" name="sessionType" id="typeSprint" value="Sprint" 
                       checked="@(_selectedSessionType == "Sprint")" @onchange="@(e => SelectSessionType("Sprint"))">
                <label class="btn btn-outline-primary" for="typeSprint">
                    🍅 Sprint (@_sprintDuration min)
                </label>

                <input type="radio" class="btn-check" name="sessionType" id="typeShortBreak" value="ShortBreak" 
                       checked="@(_selectedSessionType == "ShortBreak")" @onchange="@(e => SelectSessionType("ShortBreak"))">
                <label class="btn btn-outline-success" for="typeShortBreak">
                    ☕ Pause courte (@_shortBreakDuration min)
                </label>

                <input type="radio" class="btn-check" name="sessionType" id="typeLongBreak" value="LongBreak" 
                       checked="@(_selectedSessionType == "LongBreak")" @onchange="@(e => SelectSessionType("LongBreak"))">
                <label class="btn btn-outline-info" for="typeLongBreak">
                    🌙 Pause longue (@_longBreakDuration min)
                </label>
            </div>
        }

        @if (IsParticipantWaiting)
        {
            <!-- Participant en attente de l'hôte : un panneau d'attente à la place du minuteur (pas de 00:00 figé) -->
            <div class="kf-group-wait">
                <span class="kf-group-wait__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@F["Group.Waiting"]</strong>
                @if (HostName is { } waitedHost)
                {
                    <span class="kf-group-wait__body">@F.Format("Group.Waiting.Body", waitedHost)</span>
                }
            </div>
        }
        else
        {
            <!-- Horloge circulaire -->
            <svg viewBox="0 0 220 220" width="220" height="220" style="overflow:visible">
                <!-- Cercle de fond -->
                <circle cx="110" cy="110" r="95"
                        fill="none"
                        stroke="#e9ecef"
                        stroke-width="14" />
                <!-- Arc de progression -->
                <circle cx="110" cy="110" r="95"
                        fill="none"
                        stroke="@ArcColor"
                        stroke-width="14"
                        stroke-linecap="round"
                        stroke-dasharray="@_circumference.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                        stroke-dashoffset="@DashOffset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                        transform="rotate(-90 110 110)"
                        style="transition: stroke-dashoffset 0.8s linear, stroke 0.4s ease;" />
                <!-- Temps restant -->
                <text x="110" y="105"
                      text-anchor="middle"
                      dominant-baseline="middle"
                      font-size="42"
                      font-family="monospace"
                      fill="currentColor">
                    @TimeDisplay
                </text>
                <!-- Statut -->
                <text x="110" y="148"
                      text-anchor="middle"
                      font-size="15"
                      fill="#6c757d">
                    @StatusLabel
                </text>
            </svg>
        }

        <!-- Boutons de contrôle : une seule action principale par moment -->
        <div class="d-flex flex-wrap justify-content-center gap-2">
            @if (IsIdle)
            {
                if (IsHostWaiting)
                {
                    @* H2: the host's "Démarrer" says its effect on the others. *@
                    <button type="button" class="btn btn-primary btn-lg" @onclick="LaunchGroupStepAsync" disabled="@_launching">
                        @F["Group.Start"]
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-lg kf-btn-stop" @ref="_stopButton"
                            @onclick="OpenStopDialog" disabled="@_launching">
                        @F["Group.Stop"]
                    </button>
                }
                else if (IsParticipantWaiting)
                {
                    <button type="button" class="btn btn-outline-secondary btn-lg kf-btn-leave" @onclick="LeaveGroupAsync" disabled="@_leaving">
                        @F["Group.Leave"]
                    </button>
                }
                else
                {
                    <button class="btn btn-primary btn-lg" @ref="_startButton" @onclick="StartSession" disabled="@_starting">
                        @(_starting ? "Démarrage…" : "▶ Démarrer")
                    </button>
                }
            }
            else if (_session!.Status == "Active")
            {
                if (_completionFailed)
                {
                    <button class="btn btn-primary btn-lg" @onclick="CompleteSession" disabled="@_completing">
                        @(_completing ? "Nouvelle tentative…" : "↻ Réessayer")
                    </button>
                }

                @* In a group, "Interrompre" goes: the host stops it for everyone (confirmed), a participant leaves it alone. *@
                if (IsGroupLive && IsHost)
                {
                    <button type="button" class="btn btn-outline-danger btn-lg kf-btn-stop" @ref="_stopButton"
                            @onclick="OpenStopDialog" disabled="@_completing">
                        @F["Group.Stop"]
                    </button>
                }
                else if (IsGroupLive)
                {
                    <button type="button" class="btn btn-outline-secondary btn-lg kf-btn-leave" @onclick="LeaveGroupAsync"
                            disabled="@(_completing || _leaving)">
                        @F["Group.Leave"]
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-warning btn-lg" @onclick="InterruptSession" disabled="@_completing">
                        ⏹ Interrompre
                    </button>
                }
            }
        </div>

        @if (IsHostWaiting && _group!.WaitLimitAt is { } waitLimit)
        {
            @* Small and muted, never announced: the countdown has no live region (role="timer"). *@
            <p class="kf-group-note mb-0">
                @(WaitLimit.Before)<SprintCountdown EndsAt="waitLimit" OnElapsed="RefreshGroupAsync" />@(WaitLimit.After)
            </p>
        }

        @if (IsGroupLive && !IsHost && IsSessionActive && HostName is { } followedHost)
        {
            <p class="kf-group-note mb-0">@F.Bold(F["Group.Follow.Hint"], followedHost)</p>
        }

        @if (CanManageGroup)
        {
            <div class="d-flex flex-column align-items-center gap-1 text-center" style="max-width:480px">
                @* aria-disabled rather than disabled during the call: the keyboard focus stays on the button (the handler ignores a second click). *@
                <button type="button" class="btn btn-link btn-sm kf-btn-close-group @(_closingGroup ? "disabled" : "")"
                        aria-describedby="group-closed-hint"
                        aria-disabled="@(_closingGroup ? "true" : null)"
                        @onclick="ToggleGroupClosed">
                    @F[ClosedKey]
                </button>
                <small id="group-closed-hint" class="text-body-secondary">
                    @F[$"{ClosedKey}.Hint"]
                </small>
            </div>
        }

        <!-- Résultat après fin de session (pas dans un groupe : la suite y est la bande ou l'attente) -->
        @if (_completedSessionType is not null && !IsGroupLive)
        {
            var (icon, label, next) = _completedSessionType switch
            {
                "Sprint"     => ("🍅", "Sprint terminé !",      _suggestedNextSessionType switch { "LongBreak" => "Pause recommandée : longue", "ShortBreak" => "Pause recommandée : courte", _ => "" }),
                "ShortBreak" => ("☕", "Pause courte terminée !", "Sprint recommandé !"),
                "LongBreak"  => ("🌙", "Pause longue terminée !", "Sprint recommandé !"),
                _            => ("✅", "Session terminée !",       "")
            };
            <div class="alert alert-success text-center" style="max-width:360px">
                @icon @label <strong>@next</strong>
            </div>
        }

        <!-- Tâches liées au sprint actif — masqué pendant une pause -->
        @if (_session?.Status == "Active" && _session.SessionType == "Sprint")
        {
            <div style="width:100%;max-width:480px">
                <h5 class="mb-2">Tâches du sprint</h5>

                @if (_linkedTasks.Count > 0)
                {
                    <ul class="list-group mb-3">
                        @foreach (var task in _linkedTasks)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex gap-2 align-items-center">
                                    <span class="@(task.Status == "Done" ? "text-decoration-line-through text-muted" : "")">
                                        @task.Title
                                    </span>
                                    @if (task.Tags is { Count: > 0 })
                                    {
                                        <span class="badge bg-light text-dark border">@task.Tags[0]</span>
                                    }
                                </span>
                                <span class="d-flex gap-2 align-items-center">
                                    <span class="badge @BadgeClass(task.Status)">@task.Status</span>
                                    @if (task.Status == "Pending")
                                    {
                                        <button class="btn btn-sm btn-outline-primary"
                                                title="Marquer @task.Title en cours"
                                                aria-label="Marquer la tâche @task.Title comme en cours"
                                                @onclick="() => SetTaskInProgress(task.Id)">
                                            En cours
                                        </button>
                                    }
                                    @if (task.Status != "Done")
                                    {
                                        <button class="btn btn-sm btn-success"
                                                title="Terminer @task.Title"
                                                aria-label="Terminer la tâche @task.Title"
                                                @onclick="() => CompleteLinkedTask(task.Id)">
                                            ✓
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger"
                                            title="Retirer @task.Title du sprint"
                                            aria-label="Retirer la tâche @task.Title du sprint"
                                            @onclick="() => UnlinkTask(task.Id)">
                                        ✕
                                    </button>
                                </span>
                            </li>
                        }
                    </ul>
                }

                <!-- Lier une tâche existante -->
                <div class="mb-2">
                    <select class="form-select form-select-sm" @bind="_selectedTaskIdToLink">
                        <option value="">— Lier une tâche existante —</option>
                        @foreach (var task in GetLinkableTasks())
                        {
                            <option value="@task.Id">@FormatTaskOption(task)</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-outline-secondary mt-1"
                            disabled="@string.IsNullOrEmpty(_selectedTaskIdToLink)"
                            @onclick="LinkExistingTask">
                        Lier
                    </button>
                </div>

                <!-- Créer une nouvelle tâche -->
                <div class="d-flex gap-2">
                    <input class="form-control form-control-sm"
                           placeholder="Nouvelle tâche pendant le sprint…"
                           @bind="_newTaskTitle"
                           @bind:event="oninput"
                           @onkeydown="OnNewTaskKeyDown" />
                    <button class="btn btn-sm btn-primary"
                            disabled="@string.IsNullOrWhiteSpace(_newTaskTitle)"
                            @onclick="CreateTask">
                        +
                    </button>
                </div>
            </div>
        }

        @if (_infoMessage is not null)
        {
            <div class="alert alert-info" role="status" style="max-width:480px">@_infoMessage</div>
        }

        @if (_errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert" style="max-width:480px">@_errorMessage</div>
        }
    </div>
}

<XpToast @ref="_xpToast" />

<GroupStopDialog Open="StopDialogOpen" DuringSprint="@(_session is { Status: "Active", SessionType: "Sprint" })"
                 OnConfirm="StopGroupAsync" OnCancel="CancelStop" />

@code {
    // ── Constantes SVG ─────────────────────────────────────────────────────
    private const double Radius = 95.0;
    private readonly double _circumference = 2 * Math.PI * Radius;

    // ── Menu contextuel ───────────────────────────────────────────────────
    private bool _moreMenuOpen;

    private void ToggleMoreMenu() => _moreMenuOpen = !_moreMenuOpen;

    private void NavigateToSprintLibre()
    {
        _moreMenuOpen = false;
        Nav.NavigateTo("/pomodoro/libre");
    }

    /// <summary>Optional <c>?type=sprint</c> from the Community page: preselects the sprint when no session is running.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "type")] public string? TypeQuery { get; set; }

    /// <summary>Optional <c>?start=sprint</c> from the dashboard: starts a sprint on arrival, through
    /// <see cref="StartSession"/>, then is removed from the address (see the end of <see cref="OnInitializedAsync"/>).</summary>
    [Parameter, SupplyParameterFromQuery(Name = PomodoroAutoStart.QueryName)] public string? StartQuery { get; set; }

    // ── État ──────────────────────────────────────────────────────────────
    private bool _loaded;
    private PomodoroSessionDto? _session;
    private string? _completedSessionType;
    private string? _suggestedNextSessionType;
    private List<TaskDto> _allTasks = [];
    private List<TaskDto> _linkedTasks = [];
    private string? _errorMessage;
    private string? _infoMessage;
    private bool _starting;
    private bool _completing;       // a completion request is in flight (blocks double submit)
    private bool _completionFailed; // the last completion failed and the session may still be active: offer "Réessayer"
    private string _newTaskTitle = string.Empty;
    private string _selectedTaskIdToLink = string.Empty;
    private XpToast? _xpToast;

    // ── Shared sprint (community) ─────────────────────────────────────────
    private bool _isMember;      // read once, without blocking the page; a failure means "not a member" (no button)
    private string? _myName;     // my community name, read with the membership: names my own desk's ambiance
    private bool _closingGroup;  // a close/reopen request is in flight
    private bool _disposed;

    // ── Group session (#46) ───────────────────────────────────────────────
    // The page reads GET current-session at load, then every 15 s during a session or a live group (hidden tab
    // included: a participant must keep following). A participant with no step running follows the host every 5 s.
    private static readonly TimeSpan GroupTick = TimeSpan.FromSeconds(5);
    private const int GroupReadEveryTicks = 3;     // 3 × 5 s = 15 s
    private const int MaxSilentGroupFailures = 3;  // H4: an error is shown only after 3 failures in a row

    private CurrentGroupSessionDto? _group;
    private bool _groupWasLive;          // this page saw the group live: its end gets a message (once)
    private int _lastSprintNumber;       // sprints of the group seen last, for the summary at its end
    private int _groupFailures;          // failed reads or follows in a row
    private int _groupReadSeq;           // the newest read wins: an older answer arriving late is dropped
    private bool _groupSyncing;          // a read or a follow is in flight (the loop skips its tick)
    private bool _launching;             // the host's "Lancer pour le groupe" is in flight
    private bool _leaving;               // leaving or stopping is in flight
    private bool _stopDialogOpen;
    private string? _groupAnnouncement;  // the live region's text
    private string? _announcedState;     // "Phase:StepNumber" last announced, so that each change is announced once
    private GroupEndNotice? _groupEnd;
    private int _pendingXp;              // XP to toast once the toast is rendered
    private CancellationTokenSource? _groupLoopCts;
    private ElementReference _stopButton;
    private ElementReference _startButton;
    private FocusTarget _pendingFocus;

    private enum FocusTarget { None, StopButton, StartButton }

    /// <summary>The end of the group as shown above the usual screen: its reason, and how many sprints were done together.</summary>
    private sealed record GroupEndNotice(string Reason, int SprintsTogether);

    private bool IsGroupLive => _group is { IsGroup: true } && _group.Phase != "Ended";
    private bool IsHost => _group?.Role == "Host";
    private bool IsIdle => _session is null || _session.Status is "Completed" or "Interrupted";
    private bool IsSessionActive => _session is { Status: "Active" };

    /// <summary>The host between two steps: "À toi de lancer la suite".</summary>
    private bool IsHostWaiting => IsGroupLive && IsHost && IsIdle;

    /// <summary>A participant with no step running: waits for the host, no timer, no type.</summary>
    private bool IsParticipantWaiting => IsGroupLive && !IsHost && IsIdle;

    private bool ShowTypeTabs => IsIdle && !IsParticipantWaiting;

    private bool StopDialogOpen => _stopDialogOpen && IsGroupLive && IsHost;

    /// <summary>For a participant, the host is the first of the others (the members read lists the host first).</summary>
    private string? HostName => IsGroupLive && !IsHost && _group!.Others.Count > 0 ? _group.Others[0].Name : null;

    /// <summary>Whose desk the ambiance belongs to: mine when I host, the host's otherwise.</summary>
    private string? AmbianceHostName => IsHost ? _myName : HostName;

    /// <summary>"Sans choix, la session se termine dans {0}" cut around its placeholder, so that the countdown takes its place.</summary>
    private (string Before, string After) WaitLimit
    {
        get
        {
            var template = F["Group.WaitLimit"];
            return CommunityFormatter.SplitAtPlaceholder(template) ?? (template + " ", "");
        }
    }

    /// <summary>"Fermer / Rouvrir la session": only the host, during a step, and only when a community member. A sprint
    /// nobody joined yet (no group) keeps the sprint wording. Not while waiting: nobody can join a group then.
    /// A free sprint never reaches <c>_session</c> (see <see cref="TryAdoptTimedSession"/>), so it never shows it.</summary>
    private bool CanManageGroup =>
        _isMember
        && _group is { Role: "Host", Phase: "Running" } group
        && IsSessionActive
        && (group.IsGroup || _session!.SessionType == "Sprint");

    private string ClosedKey =>
        (_group!.IsGroup ? "Group" : "Participants") + (_group.IsClosedToJoin ? ".Reopen" : ".Close");

    // ── Session type selection ────────────────────────────────────────────
    private string _selectedSessionType = "Sprint";
    private int _sprintDuration = 25;
    private int _shortBreakDuration = 5;
    private int _longBreakDuration = 15;
    private string _ringtonePreference = "AlarmClock";
    private int _alarmVolume = 80;

    // ── Timer ─────────────────────────────────────────────────────────────
    private int _remainingSeconds;
    private int _totalSeconds;
    private DateTime? _deadlineUtc; // StartedAt + planned duration, compared with the device clock
    private CancellationTokenSource? _timerCts;

    // ── Computed ──────────────────────────────────────────────────────────
    // The host between two steps sees the ring at rest on the duration of the chosen step.
    private string TimeDisplay =>
        IsHostWaiting
            ? $"{SelectedDurationMinutes:D2}:00"
            : _remainingSeconds >= 0
                ? $"{_remainingSeconds / 60:D2}:{_remainingSeconds % 60:D2}"
                : "00:00";

    private int SelectedDurationMinutes => _selectedSessionType switch
    {
        "ShortBreak" => _shortBreakDuration,
        "LongBreak" => _longBreakDuration,
        _ => _sprintDuration
    };

    private string StatusLabel => _session?.Status switch
    {
        "Active" => _session.SessionType switch
        {
            "Sprint" => "Sprint en cours",
            "ShortBreak" => "Pause courte",
            "LongBreak" => "Pause longue",
            _ => "En cours"
        },
        "Completed"   => "Terminé",
        "Interrupted" => "Interrompu",
        _             => "Prêt"
    };

    private string ArcColor => _session?.Status switch
    {
        "Active" => _session.SessionType switch
        {
            "Sprint" => "#0d6efd",      // Bleu pour sprint
            "ShortBreak" => "#198754",  // Vert pour pause courte
            "LongBreak" => "#0dcaf0",   // Cyan pour pause longue
            _ => "#0d6efd"
        },
        "Completed"   => "#198754",
        "Interrupted" => "#ffc107",
        _             => "#adb5bd"
    };

    private double DashOffset
    {
        get
        {
            if (_totalSeconds <= 0 || _session?.Status != "Active")
                return 0;
            var progress = Math.Clamp((double)_remainingSeconds / _totalSeconds, 0, 1);
            return _circumference * (1 - progress);
        }
    }

    private IEnumerable<TaskDto> GetLinkableTasks() =>
        _allTasks.Where(t =>
            t.Status != "Done" &&
            (_session is null || !_session.LinkedTaskIds.Contains(t.Id)));

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Started first and not awaited: it must never delay the page (see LoadMembershipAsync).
        _ = LoadMembershipAsync();

        // None of the secondary loads below may keep the page on "Chargement…" or prevent a running
        // session from being resumed: each failure is absorbed and falls back to the field defaults.
        try
        {
            _allTasks = await TaskApi.GetAllAsync();
        }
        catch (Exception ex) when (IsApiCallFailure(ex))
        {
            // The task list is the only fallback the user can see (linking tasks), so tell them.
            _allTasks = [];
            _errorMessage = "Impossible de charger les tâches.";
        }

        // The group first: it decides below whether the session is adopted (UC-CO-14 A4 → A3). A failed read
        // leaves the page as it is without a group; the loop reads it again.
        var group = await CommunityApi.GetCurrentSessionAsync();
        if (group.Succeeded) ApplyInitialGroup(group.Session);

        _session  = await PomodoroApi.GetCurrentSessionAsync();
        // Read before the adoption below: it sets _session back to null for a free sprint, which still runs.
        var hadSessionAtLoad = _session is not null;

        // Load suggested session type and durations (silent fallback to the field defaults)
        var suggested = await GetSuggestedSessionTypeOrNullAsync();
        if (suggested is not null)
        {
            _selectedSessionType = suggested.SuggestedType;
            _sprintDuration = suggested.SprintDurationMinutes;
            _shortBreakDuration = suggested.ShortBreakDurationMinutes;
            _longBreakDuration = suggested.LongBreakDurationMinutes;
        }

        // A running session always wins, and so does a group (its host picks the steps); any value other than
        // "sprint" is ignored.
        if (_session is null && !IsGroupLive && string.Equals(TypeQuery, "sprint", StringComparison.OrdinalIgnoreCase))
        {
            _selectedSessionType = "Sprint";
        }

        // Settings only drive the ringtone and volume here: silent fallback to the field defaults.
        UserSettingsDto? userSettings = null;
        try
        {
            userSettings = await SettingsApi.GetSettingsAsync();
        }
        catch (Exception ex) when (IsApiCallFailure(ex)) { }

        if (userSettings is not null)
        {
            _ringtonePreference = userSettings.RingtonePreference;
            _alarmVolume = userSettings.AlarmVolume;
        }

        if (_group is { Role: "Participant", Phase: "Ended" } && IsSessionActive)
        {
            // This session can only be the group's: for another one, current-session would have described that one
            // (decision 4). Adopting it would end it at its own end time, with the XP of the whole sprint; follow
            // closes it at the end time of the group instead (V7). A fresh load shows no end message.
            await CloseEndedGroupSessionAsync();
        }
        else if (_session?.Status == "Active" && TryAdoptTimedSession(_session))
        {
            await StartTimerLoop();
        }
        else if (IsParticipantWaiting)
        {
            // Back after the host launched a step (P5): resume it for the time left, or wait.
            await FollowHostAsync();
        }

        RefreshLinkedTasks();
        _loaded = true;
        StartGroupLoop();

        // ?start=sprint (dashboard): a running session or a live group wins, as for ?type=sprint. The start goes
        // through StartSession, the only start path (double-click guard, 409/401/network handling, resync).
        if (StartQuery is not null)
        {
            if (!_disposed && PomodoroAutoStart.ShouldStart(StartQuery, hadSessionAtLoad, IsGroupLive))
            {
                // StartSession clears the messages of a previous attempt: keep the load error (task list)
                // unless the start reported its own.
                var loadError = _errorMessage;
                _selectedSessionType = "Sprint";
                await StartSession();
                _errorMessage ??= loadError;
            }

            // In every case (started, ignored or failed): a reload or Back must never start a second sprint.
            // Left meanwhile: the address is no longer this page's, so it is not touched.
            if (!_disposed)
                Nav.NavigateTo(Nav.GetUriWithQueryParameter(PomodoroAutoStart.QueryName, (string?)null), replace: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The toast is a child: during the first load it may not be rendered yet when the XP comes in.
        if (_pendingXp > 0 && _xpToast is not null)
        {
            var xp = _pendingXp;
            _pendingXp = 0;
            _ = _xpToast.ShowAsync(xp);
        }

        if (_pendingFocus != FocusTarget.None)
        {
            var target = _pendingFocus;
            _pendingFocus = FocusTarget.None;
            try
            {
                await (target == FocusTarget.StopButton ? _stopButton : _startButton).FocusAsync();
            }
            catch (Exception ex) when (ex is InvalidOperationException or JSException)
            {
                // The button is not on screen (the state changed meanwhile): leave the focus where it is.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_groupLoopCts is not null)
        {
            await _groupLoopCts.CancelAsync();
            _groupLoopCts.Dispose();
        }

        if (_timerCts is not null)
        {
            await _timerCts.CancelAsync();
            _timerCts.Dispose();
        }
    }

    /// <summary>Reads whether I am a community member. Any failure leaves <c>_isMember</c> false: no button, no list.</summary>
    private async Task LoadMembershipAsync()
    {
        try
        {
            var membership = await CommunityApi.GetMembershipAsync();
            if (_disposed) return;

            _isMember = membership?.IsMember == true;
            _myName = membership?.Name;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Accessory: the page works without it.
        }
    }

    // ── Actions ───────────────────────────────────────────────────────────
    /// <summary>Closes or reopens my group to new arrivals. The countdown is left alone: only the group
    /// flag changes, so the page reads the group again without touching the timer.</summary>
    private async Task ToggleGroupClosed()
    {
        if (_closingGroup || _group is not { } current) return;
        _closingGroup = true;
        _errorMessage = null;

        try
        {
            var close = !current.IsClosedToJoin;
            if (!await CommunityApi.SetSprintClosedAsync(close))
            {
                _errorMessage = F["Participants.Close.Error"];
                return;
            }

            // Read the group again; if the read fails the server did accept the change, so apply it locally.
            var seq = ++_groupReadSeq;
            var lookup = await CommunityApi.GetCurrentSessionAsync();
            if (seq != _groupReadSeq) return;

            if (lookup is { Succeeded: true, Session: { } fresh })
                await ApplyGroupAsync(fresh);
            else
                _group = current with { IsClosedToJoin = close };
        }
        catch (Exception)
        {
            _errorMessage = F["Participants.Close.Error"];
        }
        finally
        {
            _closingGroup = false;
        }
    }

    private void SelectSessionType(string sessionType)
    {
        _selectedSessionType = sessionType;
        StateHasChanged();
    }

    private async Task StartSession()
    {
        if (_starting) return;
        _starting = true;
        _errorMessage = null;
        _infoMessage = null;
        _groupEnd = null;
        _completedSessionType = null;
        _suggestedNextSessionType = null;
        _completionFailed = false;
        StateHasChanged();

        try
        {
            await StartSessionCoreAsync();

            // A sprint started by a member is open to others: read it as a group now, so that "Fermer ce sprint"
            // shows at once rather than at the next 15 s read.
            if (_isMember && IsSessionActive)
                await RefreshGroupCoreAsync();
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task StartSessionCoreAsync()
    {
        var outcome = await PomodoroApi.StartSessionAsync(_selectedSessionType);
        if (outcome.Session is null)
        {
            // The POST may have actually succeeded server-side even though we see no
            // session here (HTTP timeout on the way back, or a 409 raised by our own
            // earlier attempt once the 5s server idempotency window has elapsed).
            // Resync with the server before surfacing an error, so the user never gets
            // stuck on an errored screen while a session is genuinely running.
            var current = await PomodoroApi.GetCurrentSessionAsync();
            if (current?.Status == "Active")
            {
                if (TryAdoptTimedSession(current))
                {
                    if (current.SessionType != _selectedSessionType)
                    {
                        // The resync recovered a different session type than the one the
                        // user just asked for (e.g. an interrupted attempt actually landed
                        // as a break). Adopting it silently would leave the tab selector out
                        // of sync with no explanation — surface it instead.
                        _infoMessage = $"Une session « {SessionTypeLabel(current.SessionType)} » était déjà en cours ; on l'a reprise.";
                        _selectedSessionType = current.SessionType;
                    }

                    RefreshLinkedTasks();
                    await StartTimerLoop();
                }

                return;
            }

            _errorMessage = outcome.Error ?? "Impossible de démarrer la session.";
            return;
        }

        if (TryAdoptTimedSession(outcome.Session))
        {
            RefreshLinkedTasks();
            await StartTimerLoop();
        }
    }

    private async Task InterruptSession()
    {
        _errorMessage = null;
        await StopTimer();

        var ok = await PomodoroApi.InterruptSessionAsync();
        if (!ok)
        {
            _errorMessage = "Impossible d'interrompre le sprint.";
            return;
        }

        _session = await PomodoroApi.GetCurrentSessionAsync();
        _completedSessionType = null;
        _completionFailed = false;
        RefreshLinkedTasks();
    }

    private async Task OnTimerCompleted()
    {
        // The ringtone plays once, at expiry. Retries ("Réessayer") call CompleteSession directly,
        // which skips it. The ringtone is accessory (JS interop can fail, e.g. script not loaded):
        // a failure here must never prevent the session from being completed.
        try
        {
            await SoundService.PlayRingtoneAsync(_ringtonePreference, _alarmVolume);
        }
        catch (Exception) { }

        await CompleteSession();
    }

    /// <summary>Completes the active session. Runs from the timer loop (via <c>InvokeAsync</c>) and
    /// from the "Réessayer" button, so every state change is followed by an explicit
    /// <c>StateHasChanged()</c>. A failed attempt never leaves the page stuck: see
    /// <see cref="RecoverFromFailedCompletionAsync"/>. An unexpected exception is turned into the
    /// same recoverable failure state here rather than in the timer loop's catch-all, which also
    /// covers mid-countdown ticks where "Réessayer" would mean a premature end.</summary>
    private async Task CompleteSession()
    {
        if (_completing) return;
        _completing = true;
        _errorMessage = null;
        _infoMessage = null;
        StateHasChanged();

        try
        {
            var completedType = _session?.SessionType;
            var xpAwarded = await PomodoroApi.CompleteSessionAsync(_session?.Id);
            if (xpAwarded is null)
            {
                await RecoverFromFailedCompletionAsync();
                return;
            }

            _completionFailed = false;
            _completedSessionType = completedType;
            _session = await PomodoroApi.GetCurrentSessionAsync();
            _remainingSeconds = 0;

            var suggested = await GetSuggestedSessionTypeOrNullAsync();
            _suggestedNextSessionType = suggested?.SuggestedType;
            if (suggested is not null)
                _selectedSessionType = suggested.SuggestedType;

            RefreshLinkedTasks();
            StateHasChanged();

            if (xpAwarded.Value > 0 && _xpToast is not null)
                _ = _xpToast.ShowAsync(xpAwarded.Value);

            // A step of the group is over: the participant follows the host right away (next step, or the wait);
            // the host reads the group for "À toi de lancer la suite".
            if (IsGroupLive)
            {
                if (IsHost) await RefreshGroupCoreAsync();
                else await FollowHostAsync();
            }
        }
        catch (Exception)
        {
            // Unexpected failure: don't surface ex.Message, offer "Réessayer" instead.
            _completionFailed = true;
            _errorMessage = "Impossible de terminer la session. Réessaie.";
        }
        finally
        {
            _completing = false;
            StateHasChanged();
        }
    }

    /// <summary>Called after a failed completion request. Asks the server what became of the
    /// session. If it is gone (204 — e.g. completed from another tab, so our request got a 400),
    /// the page goes back to "Prêt" with an informational message: we can't know what was credited,
    /// so no "Sprint terminé !" banner and no XP toast. If it is still active, or the server can't
    /// be reached, the page shows an error and offers "Réessayer" (no automatic retry loop);
    /// "Interrompre" stays available.</summary>
    private async Task RecoverFromFailedCompletionAsync()
    {
        var lookup = await PomodoroApi.LookupCurrentSessionAsync();

        // Another session took over while this tab was still counting down (a group step started from
        // another tab, for instance): the server refused to end it, and this tab follows it.
        if (lookup.Session is { Status: "Active" } current && current.Id != _session?.Id)
        {
            _completionFailed = false;
            _completedSessionType = null;
            _suggestedNextSessionType = null;

            if (TryAdoptTimedSession(current))
            {
                _selectedSessionType = current.SessionType;
                RefreshLinkedTasks();
                await StartTimerLoop();
            }

            return;
        }

        if (lookup.Succeeded && lookup.Session is null)
        {
            _session = null;
            _completionFailed = false;
            _completedSessionType = null;
            _suggestedNextSessionType = null;
            _remainingSeconds = 0;
            _totalSeconds = 0;
            _infoMessage = "Cette session n'est plus active (elle a peut-être été terminée depuis un autre onglet).";
            RefreshLinkedTasks();
            return;
        }

        _completionFailed = true;
        _errorMessage = lookup.Unauthorized
            ? "Ta session a expiré, reconnecte-toi."
            : lookup.Succeeded
                ? "Impossible de terminer la session. Réessaie."
                : "Serveur injoignable, vérifie ta connexion puis réessaie.";
    }

    private async Task LinkExistingTask()
    {
        if (!Guid.TryParse(_selectedTaskIdToLink, out var id)) return;
        _errorMessage = null;

        var ok = await PomodoroApi.LinkTaskAsync(id);
        if (!ok) { _errorMessage = "Impossible de lier la tâche."; return; }

        _session = await PomodoroApi.GetCurrentSessionAsync();
        _selectedTaskIdToLink = string.Empty;
        RefreshLinkedTasks();
    }

    private async Task CreateTask()
    {
        if (string.IsNullOrWhiteSpace(_newTaskTitle)) return;
        _errorMessage = null;

        var created = await PomodoroApi.CreateTaskDuringSessionAsync(_newTaskTitle.Trim());
        if (created is null) { _errorMessage = "Impossible de créer la tâche."; return; }

        _allTasks.Add(created);
        _session = await PomodoroApi.GetCurrentSessionAsync();
        _newTaskTitle = string.Empty;
        RefreshLinkedTasks();
    }

    private async Task SetTaskInProgress(Guid taskId)
    {
        _errorMessage = null;
        var updated = await PomodoroApi.UpdateTaskStatusAsync(taskId, "InProgress");
        if (updated is null) { _errorMessage = "Impossible de mettre à jour le statut."; return; }
        UpdateLocalTask(updated);
    }

    private async Task UnlinkTask(Guid taskId)
    {
        _errorMessage = null;
        var ok = await PomodoroApi.UnlinkTaskAsync(taskId);
        if (!ok) { _errorMessage = "Impossible de retirer la tâche du sprint."; return; }

        _session = await PomodoroApi.GetCurrentSessionAsync();
        RefreshLinkedTasks();
    }

    private async Task CompleteLinkedTask(Guid taskId)
    {
        _errorMessage = null;
        var updated = await PomodoroApi.UpdateTaskStatusAsync(taskId, "Done");
        if (updated is null) { _errorMessage = "Impossible de compléter la tâche."; return; }
        UpdateLocalTask(updated);
    }

    private async Task OnNewTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newTaskTitle))
            await CreateTask();
    }

    /// <summary>Wires the local countdown-timer state onto a session reported as Active by the
    /// server, unless it's a free sprint (<c>PlannedDurationMinutes == 0</c>). Free sprints carry
    /// no planned duration, so <see cref="InitTimer"/> would compute <c>_totalSeconds = 0</c> and
    /// the timer loop would complete — and close — the session on its very first tick. This is the
    /// single choke point for every path on this page that can discover an active session: initial
    /// load, a successful start, and the resync after an ambiguous start response. Returns
    /// <c>true</c> when a timed session was adopted (the caller must then start the timer loop);
    /// <c>false</c> when the active session was a free sprint — <c>_session</c> is cleared and
    /// <c>_infoMessage</c> invites the user to rejoin it from the Sprint libre screen instead.
    /// </summary>
    private bool TryAdoptTimedSession(PomodoroSessionDto session)
    {
        if (session.PlannedDurationMinutes == 0)
        {
            _session = null;
            _infoMessage = "Un sprint libre est déjà en cours. Rejoins-le depuis « Sprint libre ».";
            return false;
        }

        _session = session;
        InitTimer(session);
        return true;
    }

    private static string SessionTypeLabel(string sessionType) => sessionType switch
    {
        "Sprint" => "Sprint",
        "ShortBreak" => "Pause courte",
        "LongBreak" => "Pause longue",
        _ => sessionType
    };

    // ── Group session (#46) ───────────────────────────────────────────────
    /// <summary>The group found at load. Nothing is announced and no end message is shown: the page did not see it change.</summary>
    private void ApplyInitialGroup(CurrentGroupSessionDto? group)
    {
        _group = group;
        if (!IsGroupLive) return;

        _groupWasLive = true;
        _lastSprintNumber = group!.SprintNumber;
        _announcedState = StateKey(group);
    }

    /// <summary>Applies a fresh read of the group: announces a new step or the wait, and handles the end of a group
    /// this page saw live (once).</summary>
    private async Task ApplyGroupAsync(CurrentGroupSessionDto? group)
    {
        var wasLive = _groupWasLive;
        var previous = _group;
        _group = group;

        if (IsGroupLive)
        {
            _groupWasLive = true;
            _lastSprintNumber = group!.SprintNumber;

            var state = StateKey(group);
            if (state != _announcedState)
            {
                // A group that just formed (someone joined my sprint) is not a new step: nothing to announce.
                if (wasLive) _groupAnnouncement = Announcement(group);
                _announcedState = state;
            }

            return;
        }

        // Over, or no group any more. A participant whose session of the group still runs closes it (UC-CO-14 A3).
        if (group is { Role: "Participant", Phase: "Ended" } && IsSessionActive)
        {
            await CloseEndedGroupSessionAsync();
            return;
        }

        if (!wasLive) return;

        // The host only hears about the group left alone; their own stop says nothing, nor does an absence they caused.
        var reason = group?.EndReason;
        EndGroup(previous?.Role == "Host" && reason != "HostAlone" ? null : reason);
        await ResyncSessionAsync();
    }

    private static string StateKey(CurrentGroupSessionDto group) => $"{group.Phase}:{group.StepNumber}";

    private string Announcement(CurrentGroupSessionDto group) =>
        group.Phase == "WaitingForHost"
            ? F[group.Role == "Host" ? "Group.YourTurn" : "Group.Waiting"]
            : F.Format("Group.Announce.Step", F.GroupStepLabel(group.StepType, group.SprintNumber));

    /// <summary>The group is over for this page. With a reason, and only if the page saw it live, the end is shown
    /// above the usual screen and announced; in every case the page will not report this end again.</summary>
    private void EndGroup(string? reason)
    {
        var sawItLive = _groupWasLive;
        _groupWasLive = false;
        _announcedState = null;
        _completedSessionType = null;
        _suggestedNextSessionType = null;

        if (sawItLive && reason is not null) ShowGroupEnded(reason);
    }

    private void ShowGroupEnded(string reason)
    {
        var text = F[$"Group.Ended.{reason}"];
        _groupEnd = new GroupEndNotice(text, _lastSprintNumber);
        _groupAnnouncement = text;
    }

    /// <summary>My session of an ended group still runs: follow closes it at the end time of the group, with the XP
    /// of V7 (UC-CO-14 A3). It is read again, never adopted. On failure it stays as it is, and the next read tries again.</summary>
    private async Task CloseEndedGroupSessionAsync()
    {
        await StopTimer();

        var result = await CommunityApi.FollowAsync();
        if (result.Outcome == FollowOutcome.Failed)
        {
            _groupFailures++;
            return;
        }

        _groupFailures = 0;
        _session = await PomodoroApi.GetCurrentSessionAsync();
        _remainingSeconds = 0;
        _totalSeconds = 0;
        _deadlineUtc = null;
        RefreshLinkedTasks();

        EndGroup(result.EndReason ?? _group?.EndReason);
        if (result.XpAwarded > 0) ShowXp(result.XpAwarded);
    }

    /// <summary>Reads my Pomodoro session again and follows it: a new active one is adopted and counted down, a
    /// gone one leaves the page ready. A failed read changes nothing.</summary>
    private async Task ResyncSessionAsync()
    {
        var lookup = await PomodoroApi.LookupCurrentSessionAsync();
        if (!lookup.Succeeded) return;

        if (lookup.Session is { Status: "Active" } current)
        {
            if (current.Id == _session?.Id && _timerCts is not null) return; // already counting it down

            _completedSessionType = null;
            _suggestedNextSessionType = null;
            _completionFailed = false;
            if (TryAdoptTimedSession(current))
            {
                RefreshLinkedTasks();
                await StartTimerLoop();
            }

            return;
        }

        await StopTimer();
        _session = lookup.Session;
        _remainingSeconds = 0;
        _totalSeconds = 0;
        _deadlineUtc = null;
        RefreshLinkedTasks();
    }

    /// <summary>Reads the group. The newest read wins; a failure only counts towards the error shown after 3 in a row.</summary>
    private async Task RefreshGroupCoreAsync()
    {
        var seq = ++_groupReadSeq;
        var lookup = await CommunityApi.GetCurrentSessionAsync();
        if (_disposed || seq != _groupReadSeq) return;

        if (!lookup.Succeeded)
        {
            _groupFailures++;
            return;
        }

        _groupFailures = 0;
        await ApplyGroupAsync(lookup.Session);
    }

    /// <summary>The periodic read, and the read when the host's waiting limit elapses.</summary>
    private async Task RefreshGroupAsync()
    {
        if (_groupSyncing) return;
        _groupSyncing = true;
        try
        {
            await RefreshGroupCoreAsync();
        }
        finally
        {
            _groupSyncing = false;
            StateHasChanged();
        }
    }

    /// <summary>A participant with no step running asks to follow the host (UC-CO-14): the step the host launched
    /// starts here without a click, with the same end time.</summary>
    private async Task FollowHostAsync()
    {
        if (_groupSyncing) return;
        _groupSyncing = true;
        try
        {
            var result = await CommunityApi.FollowAsync();
            // Left or stopped meanwhile: that path reads everything again itself.
            if (_disposed || _leaving || !IsGroupLive || IsHost) return;

            switch (result.Outcome)
            {
                case FollowOutcome.NewStep:
                case FollowOutcome.SameStep:
                    _groupFailures = 0;
                    await ResyncSessionAsync();
                    await RefreshGroupCoreAsync();
                    break;

                case FollowOutcome.Waiting:
                    _groupFailures = 0;
                    if (_group!.Phase != "WaitingForHost") await RefreshGroupCoreAsync();
                    break;

                case FollowOutcome.Ended:
                    _groupFailures = 0;
                    await ResyncSessionAsync();
                    EndGroup(result.EndReason);
                    if (result.XpAwarded > 0) ShowXp(result.XpAwarded);
                    await RefreshGroupCoreAsync();
                    break;

                case FollowOutcome.NotInGroup:
                    // Out of the group (left from another tab, or a session started elsewhere): no message.
                    _groupFailures = 0;
                    EndGroup(null);
                    await RefreshGroupCoreAsync();
                    await ResyncSessionAsync();
                    break;

                default:
                    _groupFailures++;
                    break;
            }
        }
        finally
        {
            _groupSyncing = false;
            StateHasChanged();
        }
    }

    /// <summary>The host launches the next step for the group (UC-CO-10), with the chosen type at their own durations.</summary>
    private async Task LaunchGroupStepAsync()
    {
        if (_launching) return;
        _launching = true;
        _errorMessage = null;
        _infoMessage = null;
        _groupEnd = null;

        try
        {
            switch (await CommunityApi.LaunchStepAsync(_selectedSessionType))
            {
                case LaunchStepOutcome.Launched:
                    _groupFailures = 0;
                    await ResyncSessionAsync();
                    await RefreshGroupCoreAsync();
                    break;

                case LaunchStepOutcome.HostAlone:
                    // Nobody left in the group: it is over, and the step starts as an ordinary solo session (A1).
                    EndGroup(null);
                    _group = null;
                    await StartSession();
                    ShowGroupEnded("HostAlone");
                    break;

                case LaunchStepOutcome.StepRunning:
                    // Double click or a second tab: the step exists already, follow it without a message.
                    await ResyncSessionAsync();
                    await RefreshGroupCoreAsync();
                    break;

                case LaunchStepOutcome.GroupEnded:
                    // Past the waiting limit: the group is over (E2).
                    EndGroup(null);
                    await RefreshGroupCoreAsync();
                    ShowGroupEnded("HostAbsent");
                    break;

                default:
                    _errorMessage = F["Group.Error"];
                    break;
            }
        }
        finally
        {
            _launching = false;
        }
    }

    private void OpenStopDialog()
    {
        if (_launching || _leaving) return;
        _stopDialogOpen = true;
    }

    private void CancelStop()
    {
        _stopDialogOpen = false;
        _pendingFocus = FocusTarget.StopButton;
    }

    /// <summary>The host confirmed: the session stops for the whole group (UC-CO-12). Their own stop shows no message.</summary>
    private async Task StopGroupAsync()
    {
        if (_leaving) return;
        _leaving = true;
        _errorMessage = null;

        try
        {
            if (!await CommunityApi.LeaveOrStopAsync())
            {
                _stopDialogOpen = false;
                _errorMessage = F["Group.Error"];
                _pendingFocus = FocusTarget.StopButton;
                return;
            }

            _stopDialogOpen = false;
            await StopTimer();
            EndGroup(null);
            await ResyncSessionAsync();
            await RefreshGroupCoreAsync();
            _pendingFocus = FocusTarget.StartButton;
        }
        finally
        {
            _leaving = false;
        }
    }

    /// <summary>A participant leaves the group alone, without confirmation (UC-CO-11), during a step or the wait.</summary>
    private async Task LeaveGroupAsync()
    {
        if (_leaving) return;
        _leaving = true;
        _errorMessage = null;

        try
        {
            if (!await CommunityApi.LeaveOrStopAsync())
            {
                _errorMessage = F["Group.Error"];
                return;
            }

            await StopTimer();
            EndGroup(null);
            await ResyncSessionAsync();
            await RefreshGroupCoreAsync();
            _pendingFocus = FocusTarget.StartButton;
        }
        finally
        {
            _leaving = false;
        }
    }

    private void ShowXp(int xp)
    {
        if (_xpToast is null)
        {
            _pendingXp = xp;
            return;
        }

        _ = _xpToast.ShowAsync(xp);
    }

    private void StartGroupLoop()
    {
        // OnInitializedAsync starts the loop after its awaits: the page may have been left meanwhile, and
        // DisposeAsync found no loop to cancel. Started now, the loop would tick until the tab is reloaded.
        if (_disposed) return;

        _groupLoopCts = new CancellationTokenSource();
        _ = GroupLoopAsync(_groupLoopCts.Token);
    }

    /// <summary>Runs as long as the page is open, hidden tab included (spec §6): a participant must keep following.
    /// Each tick does nothing while another group request or a start, an end or a launch is in flight.</summary>
    private async Task GroupLoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(GroupTick);
            var tick = 0;
            while (await timer.WaitForNextTickAsync(ct))
            {
                tick++;
                var readDue = tick % GroupReadEveryTicks == 0;
                try
                {
                    await InvokeAsync(() => OnGroupTickAsync(readDue));
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // A failed tick is retried at the next one: the loop must outlive it.
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Page left.
        }
    }

    private async Task OnGroupTickAsync(bool readDue)
    {
        if (_disposed || _groupSyncing || _launching || _leaving || _starting || _completing) return;

        // Every 5 s: a participant with no step running follows the host.
        if (IsParticipantWaiting) await FollowHostAsync();

        // Every 15 s: the group (participants, state, end) during a session or a live group.
        if (readDue && !_disposed && (IsGroupLive || (_isMember && IsSessionActive))) await RefreshGroupAsync();
    }

    // ── Timer internals ───────────────────────────────────────────────────
    private void InitTimer(PomodoroSessionDto session)
    {
        if (session.SharedEndAt is { } sharedEnd)
        {
            // A sprint joined from a group: everyone ends at the same instant, so the deadline is the shared end and
            // the total is what remained when this session started (at least 1: the ring divides by it).
            _deadlineUtc = sharedEnd;
            _totalSeconds = Math.Max(1, (int)Math.Ceiling((sharedEnd - (session.StartedAt ?? DateTime.UtcNow)).TotalSeconds));
        }
        else
        {
            _totalSeconds = session.PlannedDurationMinutes * 60;
            // No StartedAt should not happen on an Active session: fall back to "starts now".
            _deadlineUtc = (session.StartedAt ?? DateTime.UtcNow).AddSeconds(_totalSeconds);
        }

        _remainingSeconds = ComputeRemainingSeconds();
    }

    // Recomputed from the deadline at every tick, so a late tick (throttled tab) has no lasting effect.
    // Ceiling: zero only once the deadline is really reached; clamp: a slow device clock never shows more than the total.
    // Math.Max on the upper bound: Math.Clamp throws when max < min, and the duration comes from the server.
    private int ComputeRemainingSeconds() =>
        _deadlineUtc is { } deadline
            ? Math.Clamp((int)Math.Ceiling((deadline - DateTime.UtcNow).TotalSeconds), 0, Math.Max(0, _totalSeconds))
            : 0;

    private async Task StartTimerLoop()
    {
        await StopTimer();
        _timerCts = new CancellationTokenSource();
        var token = _timerCts.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            try
            {
                // Check first, wait after: an already-expired session is completed right away.
                do
                {
                    _remainingSeconds = ComputeRemainingSeconds();
                    await InvokeAsync(StateHasChanged);

                    if (_remainingSeconds <= 0)
                    {
                        await InvokeAsync(OnTimerCompleted);
                        break;
                    }
                }
                while (await timer.WaitForNextTickAsync(token));
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = $"Erreur de fin de session : {ex.Message}";
                    StateHasChanged();
                });
            }
        }, token);
    }

    private async Task StopTimer()
    {
        if (_timerCts is not null)
        {
            await _timerCts.CancelAsync();
            _timerCts.Dispose();
            _timerCts = null;
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────
    /// <summary>True for the exceptions an API call can raise on a non-2xx status
    /// (<c>GetFromJsonAsync</c>), a network error, a timeout or an unparsable body.</summary>
    private static bool IsApiCallFailure(Exception ex) =>
        ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException;

    /// <summary><c>GetSuggestedSessionTypeAsync</c> throws on a network error (unlike on a non-2xx
    /// status, where it returns null). The suggestion is only a convenience, so a failure falls
    /// back to <c>null</c>.</summary>
    private async Task<SuggestedSessionTypeDto?> GetSuggestedSessionTypeOrNullAsync()
    {
        try
        {
            return await PomodoroApi.GetSuggestedSessionTypeAsync();
        }
        catch (Exception ex) when (IsApiCallFailure(ex))
        {
            return null;
        }
    }

    private void RefreshLinkedTasks()
    {
        if (_session is null) { _linkedTasks = []; return; }
        var ids = _session.LinkedTaskIds.ToHashSet();
        _linkedTasks = _allTasks.Where(t => ids.Contains(t.Id)).ToList();
    }

    private void UpdateLocalTask(TaskDto updated)
    {
        var idx = _allTasks.FindIndex(t => t.Id == updated.Id);
        if (idx >= 0) _allTasks[idx] = updated;
        RefreshLinkedTasks();
    }

    private static string FormatTaskOption(TaskDto task) =>
        task.Tags is { Count: > 0 }
            ? $"[{task.Tags[0]}] {task.Title}"
            : task.Title;

    private static string BadgeClass(string status) => status switch
    {
        "Done"       => "bg-success",
        "InProgress" => "bg-warning text-dark",
        _            => "bg-secondary"
    };
}
