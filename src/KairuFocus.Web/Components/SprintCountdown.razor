@* Time left until a shared end. Owns a one-second timer, so only this component re-renders every second. *@
@implements IAsyncDisposable
@inject TimeProvider Clock

<span class="kf-countdown" role="timer">@Label</span>

@code {
    [Parameter, EditorRequired] public DateTimeOffset EndsAt { get; set; }

    /// <summary>Raised once, when the time left reaches zero: the parent can read its data again (the sprint is over).</summary>
    [Parameter] public EventCallback OnElapsed { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private DateTimeOffset _elapsedRaisedFor;

    private string Label
    {
        get
        {
            var left = EndsAt - Clock.GetUtcNow();
            if (left < TimeSpan.Zero) left = TimeSpan.Zero;
            var totalMinutes = (int)left.TotalMinutes;
            return left.TotalHours >= 1
                ? FormattableString.Invariant($"{(int)left.TotalHours}:{left.Minutes:00}:{left.Seconds:00}")
                : FormattableString.Invariant($"{totalMinutes:00}:{left.Seconds:00}");
        }
    }

    protected override void OnInitialized() => _ = TickAsync(_cts.Token);

    private async Task TickAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(StateHasChanged);

                // Once per end time: a new EndsAt (the sprint was replaced) can raise it again.
                if (Clock.GetUtcNow() >= EndsAt && _elapsedRaisedFor != EndsAt)
                {
                    _elapsedRaisedFor = EndsAt;
                    await InvokeAsync(() => OnElapsed.InvokeAsync());
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Disposed.
        }
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
