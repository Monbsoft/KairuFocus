@* Section "Classement de la communauté" of the settings: the only place where one joins the leaderboard,
   draws another pseudonym or leaves. The pseudonym is always generated, never typed.
   Reached from the Community page through the anchor `settings#classement`: once the section has loaded, the page
   scrolls to it and the focus moves to its title. *@
@inject GamificationApiClient Gamification
@inject IJSRuntime JS
@inject CommunityFormatter F

<div class="mb-5 kf-lb-section" id="classement">
    <h4 id="classement-title" tabindex="-1"><span aria-hidden="true">🏆</span> @F["Settings.Leaderboard.Title"]</h4>

    @if (_loading)
    {
        <p class="text-muted">@F["Settings.Leaderboard.Loading"]</p>
    }
    else if (_loadFailed)
    {
        <p class="text-danger mb-2" role="alert">@F["Settings.Leaderboard.LoadError"]</p>
    }
    else if (!_isParticipant)
    {
        <p class="mb-2">@F["Settings.Leaderboard.Out"]</p>
        <div class="form-text mb-3">@F["Settings.Leaderboard.Out.Hint"]</div>
        <button type="button" class="btn btn-primary" @ref="_joinButton" @onclick="JoinAsync" disabled="@(_operation != Operation.None)">
            @(_operation == Operation.Join ? F["Settings.Leaderboard.Joining"] : F["Settings.Leaderboard.Join"])
        </button>
    }
    else
    {
        <p class="mb-2" tabindex="-1" @ref="_stateText">@F.Bold(F["Settings.Leaderboard.In"], _pseudonym ?? "")</p>
        <button type="button" class="btn btn-outline-secondary" @ref="_rerollButton" @onclick="RerollAsync" disabled="@(_operation != Operation.None)">
            @(_operation == Operation.Reroll ? F["Settings.Leaderboard.Rerolling"] : F["Settings.Leaderboard.Reroll"])
        </button>
        <div class="form-text mt-2" aria-live="polite">@_rerollMessage</div>

        <div class="kf-lb-danger">
            <button type="button" class="btn btn-outline-danger" @ref="_leaveButton" @onclick="OpenLeave" disabled="@(_operation != Operation.None)">
                @F["Settings.Leaderboard.Leave"]
            </button>
        </div>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger mt-3" role="alert">@_error</div>
    }

    @* Always mounted, so that what is added later is announced. *@
    <div class="visually-hidden" role="status" aria-live="polite">@_announcement</div>
</div>

@if (_leaveOpen)
{
    <div class="modal d-block kf-lb-modal" @ref="_modal" tabindex="-1" style="background:rgba(0,0,0,.5);"
         role="dialog" aria-modal="true" aria-labelledby="classement-leave-title" aria-describedby="classement-leave-body"
         aria-busy="@(_operation == Operation.Leave ? "true" : null)"
         @onkeydown="OnModalKeyDown">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="classement-leave-title">@F["Settings.Leaderboard.Leave.Title"]</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0" id="classement-leave-body">@F["Settings.Leaderboard.Leave.Body"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @ref="_cancelButton" @onclick="CancelLeave"
                            disabled="@(_operation == Operation.Leave)">@F["Settings.Leaderboard.Leave.Cancel"]</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmLeaveAsync"
                            disabled="@(_operation == Operation.Leave)">@F["Settings.Leaderboard.Leave.Confirm"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private enum Operation { None, Join, Reroll, Leave }

    /// <summary>Where the focus goes after the next render (a button that was just disabled or removed loses it).</summary>
    private enum FocusTarget { None, Join, State, Reroll, Leave, ModalCancel, Modal }

    private ElementReference _joinButton;
    private ElementReference _stateText;
    private ElementReference _rerollButton;
    private ElementReference _leaveButton;
    private ElementReference _cancelButton;
    private ElementReference _modal;

    private bool _loading = true;
    private bool _loadFailed;
    private bool _isParticipant;
    private string? _pseudonym;

    private Operation _operation;
    private bool _leaveOpen;
    private string? _error;
    private string? _announcement;
    private string _rerollMessage = "";

    private FocusTarget _pendingFocus;
    private bool _anchorPending = true;

    protected override async Task OnInitializedAsync() => await LoadStatusAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus != FocusTarget.None)
        {
            var target = _pendingFocus;
            _pendingFocus = FocusTarget.None;
            await FocusAsync(target);
        }

        // Arrival through settings#classement: only once the section has loaded, since it changes shape.
        if (_anchorPending && !_loading)
        {
            _anchorPending = false;
            try
            {
                await JS.InvokeAsync<bool>("kairufocusCommunity.focusSectionIfRequested", "classement", "classement-title");
            }
            catch (JSException)
            {
                // Without the script the section simply is not scrolled into view.
            }
        }
    }

    private async Task LoadStatusAsync()
    {
        var membership = await Gamification.GetLeaderboardMembershipAsync();
        if (membership is null)
        {
            _loadFailed = true;
        }
        else
        {
            _loadFailed = false;
            _isParticipant = membership.IsParticipant;
            _pseudonym = membership.Pseudonym;
        }

        _loading = false;
    }

    // ── Actions ─────────────────────────────────────────────────────────────

    private async Task JoinAsync()
    {
        if (_operation != Operation.None) return;
        _operation = Operation.Join;
        _error = null;

        var result = await Gamification.JoinLeaderboardAsync();
        _operation = Operation.None;

        switch (result.Outcome)
        {
            case MembershipOutcome.Succeeded:
                BecomeParticipant(result.Pseudonym);
                // One announcement only: the focus moves onto the sentence that states the pseudonym, and that is
                // what gets read out. A live-region message with the same text would be heard twice.
                _announcement = null;
                _pendingFocus = FocusTarget.State;
                break;

            case MembershipOutcome.Conflict: // already a member (another tab, a double click): show the real state
                await LoadStatusAsync();
                _pendingFocus = _isParticipant ? FocusTarget.State : FocusTarget.Join;
                break;

            case MembershipOutcome.Unavailable:
                _error = F["Settings.Leaderboard.Error.Pool"];
                _pendingFocus = FocusTarget.Join;
                break;

            default:
                _error = F["Settings.Leaderboard.Error.Generic"];
                _pendingFocus = FocusTarget.Join;
                break;
        }
    }

    private async Task RerollAsync()
    {
        if (_operation != Operation.None) return;
        _operation = Operation.Reroll;
        _error = null;
        _rerollMessage = "";

        var result = await Gamification.RerollPseudonymAsync();
        _operation = Operation.None;

        switch (result.Outcome)
        {
            case MembershipOutcome.Succeeded:
                _pseudonym = result.Pseudonym;
                _rerollMessage = F.Format("Settings.Leaderboard.Saved", _pseudonym ?? "");
                _pendingFocus = FocusTarget.Reroll;
                break;

            case MembershipOutcome.NotFound: // no longer a member: show the real state
                await LoadStatusAsync();
                _pendingFocus = _isParticipant ? FocusTarget.Reroll : FocusTarget.Join;
                break;

            case MembershipOutcome.Unavailable:
                _error = F["Settings.Leaderboard.Error.Pool"];
                _pendingFocus = FocusTarget.Reroll;
                break;

            default:
                _error = F["Settings.Leaderboard.Error.Generic"];
                _pendingFocus = FocusTarget.Reroll;
                break;
        }
    }

    private void OpenLeave()
    {
        if (_operation != Operation.None) return;
        _leaveOpen = true;
        _pendingFocus = FocusTarget.ModalCancel;
    }

    private void CancelLeave()
    {
        if (_operation == Operation.Leave) return;
        _leaveOpen = false;
        _pendingFocus = FocusTarget.Leave;
    }

    private async Task ConfirmLeaveAsync()
    {
        if (_operation != Operation.None) return;
        _operation = Operation.Leave;
        _error = null;
        // Both buttons are disabled while the request runs and would drop the focus: park it on the dialog itself,
        // so that Tab and Shift+Tab stay inside (see trapFocus). The dialog is marked aria-busy meanwhile, so that
        // a screen reader does not read it all out again when it receives the focus.
        _pendingFocus = FocusTarget.Modal;

        var result = await Gamification.LeaveLeaderboardAsync();
        _operation = Operation.None;
        _leaveOpen = false;

        // NotFound means the profile is already gone: the outcome is the one the user asked for.
        if (result.Outcome is MembershipOutcome.Succeeded or MembershipOutcome.NotFound)
        {
            _isParticipant = false;
            _pseudonym = null;
            _rerollMessage = "";
            _announcement = F["Settings.Leaderboard.Left"];
            _pendingFocus = FocusTarget.Join;
        }
        else
        {
            _error = F["Settings.Leaderboard.Error.Generic"];
            _pendingFocus = FocusTarget.Leave;
        }
    }

    private void OnModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelLeave();
    }

    private void BecomeParticipant(string? pseudonym)
    {
        _isParticipant = true;
        _pseudonym = pseudonym;
        _rerollMessage = "";
    }

    // ── Focus ───────────────────────────────────────────────────────────────

    private async Task FocusAsync(FocusTarget target)
    {
        try
        {
            switch (target)
            {
                case FocusTarget.Join: await _joinButton.FocusAsync(); break;
                case FocusTarget.State: await _stateText.FocusAsync(); break;
                case FocusTarget.Reroll: await _rerollButton.FocusAsync(); break;
                case FocusTarget.Leave: await _leaveButton.FocusAsync(); break;
                case FocusTarget.ModalCancel:
                    await _cancelButton.FocusAsync();
                    await JS.InvokeVoidAsync("kairufocusCommunity.trapFocus", _modal);
                    break;
                case FocusTarget.Modal: await _modal.FocusAsync(); break;
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            // The target is not on screen any more (the state changed meanwhile): leave the focus where it is.
        }
    }
}
