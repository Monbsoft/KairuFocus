@* The live strip, first block of the page: "En sprint maintenant", one card per open group, then (Footer) "Actifs aujourd'hui".
   The data comes from the page (it refreshes them with its presence loop); this component only shows them.
   Nothing here is announced: cards come and go quietly, and the countdowns have no live region.
   Independent of the period selector. *@
@implements IDisposable
@inject CommunityFormatter F

<section class="kf-hero kf-live" aria-labelledby="open-sprints-title" aria-busy="@(Data is null && !Failed ? "true" : "false")">
    <div class="kf-live__head">
        <h2 id="open-sprints-title" tabindex="-1" @ref="_title">@F["OpenSprints.Title"]</h2>
        <p class="kf-live__sub">@F["OpenSprints.Sub"]</p>
        @* Always mounted so that the message is announced when it appears. *@
        <div role="status">
            @if (_showClosedNotice)
            {
                <p class="kf-live__closed">@F["Join.Closed"]</p>
            }
        </div>
    </div>

    @if (Failed)
    {
        <ZoneAlert Message="@F["OpenSprints.Error"]" OnRetry="OnRetry" />
    }
    else if (Data is null)
    {
        <div class="kf-live__grid" aria-hidden="true">
            <div class="kf-skel kf-live__skel"></div>
            <div class="kf-skel kf-live__skel"></div>
        </div>
        <span class="visually-hidden">@F["OpenSprints.Loading"]</span>
    }
    else if (Data.Groups.Count == 0)
    {
        <div class="kf-live__empty">
            <div class="kf-live__emptytext">
                <p class="kf-live__emptytitle">@F["OpenSprints.Empty.Title"]</p>
                <p class="kf-live__sub">@F["OpenSprints.Empty.Body"]</p>
            </div>
            <a class="kf-btn-light" href="pomodoro?type=sprint">@F["OpenSprints.Empty.Cta"]</a>
        </div>
    }
    else
    {
        var hidden = Data.Groups.Count - VisibleCards;
        var canFold = hidden > 0;

        if (!Data.ViewerIsMember)
        {
            @* Said once for the whole strip; the cards carry no button. *@
            <p class="kf-live__notice">
                <span>@F["Join.NeedMember.Body"]</span>
                <a href="settings#communaute">@F["Join.NeedMember.Link"]</a>
            </p>
        }

        <ul class="kf-live__grid" id="open-sprints-list">
            @foreach (var group in (canFold && !_expanded ? Data.Groups.Take(VisibleCards) : Data.Groups))
            {
                <OpenSprintCard @key="group.Name" Group="group" ViewerIsMember="Data.ViewerIsMember"
                                OnNoLongerOpen="HandleNoLongerOpenAsync" OnElapsed="OnChanged" />
            }
        </ul>

        @if (canFold)
        {
            <button type="button" class="kf-linkbtn kf-live__more" aria-expanded="@(_expanded ? "true" : "false")"
                    aria-controls="open-sprints-list" @onclick="ToggleExpanded"
                    @onfocus="() => _moreFocused = true" @onblur="() => _moreFocused = false">
                @(_expanded ? F["OpenSprints.Less"] : F.Plural("OpenSprints.More", hidden, F.Number(hidden)))
            </button>
        }
    }

    @Footer
</section>

@code {
    /// <summary>The last successful read; null while the first one is pending (or failed).</summary>
    [Parameter] public OpenSprintsDto? Data { get; set; }

    /// <summary>The read failed and there is nothing to show yet.</summary>
    [Parameter] public bool Failed { get; set; }

    [Parameter] public EventCallback OnRetry { get; set; }

    /// <summary>A sprint turned out to be no longer open (410) or elapsed: the page reads the list again.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>The last line of the strip ("Actifs aujourd'hui"), set by the page.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Two rows of cards on a wide screen; the rest is folded behind a button.</summary>
    private const int VisibleCards = 6;

    private static readonly TimeSpan NoticeDuration = TimeSpan.FromSeconds(10);

    private readonly CancellationTokenSource _cts = new();
    private ElementReference _title;
    private bool _showClosedNotice;

    // The unfolded state survives the reads of the page. If a read brings the list back to six or less while the
    // button has the focus, the button goes away: the focus then moves to the title, never to the body.
    private bool _expanded;
    private bool _moreFocused;
    private bool _focusTitle;

    protected override void OnParametersSet()
    {
        if (Data is not { } data || data.Groups.Count > VisibleCards) return;

        if (_expanded && _moreFocused) _focusTitle = true;
        _expanded = false;
        _moreFocused = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusTitle) return;

        _focusTitle = false;
        await _title.FocusAsync();
    }

    private void ToggleExpanded() => _expanded = !_expanded;

    /// <summary>The sprint just closed or ended (410): say it, read the list again, and let the message fade after a while.</summary>
    private async Task HandleNoLongerOpenAsync()
    {
        _showClosedNotice = true;
        _ = HideNoticeLaterAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task HideNoticeLaterAsync()
    {
        try
        {
            await Task.Delay(NoticeDuration, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _showClosedNotice = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => _cts.Cancel();
}
