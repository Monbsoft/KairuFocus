@* "Join this sprint" for the open sprint of TargetName. A visitor outside the community gets a link to the settings.
   The button is disabled from the click on, so a second click cannot start a second session.
   Nothing here announces an arrival to the people already in the sprint. *@
@inject CommunityApiClient Community
@inject CommunityFormatter F
@inject NavigationManager Nav
@inject TimeProvider Clock

<div class="kf-join">
    @if (!ViewerIsMember || _outcome == JoinSprintOutcome.NotMember)
    {
        <p class="kf-join__text">@F["Join.NeedMember.Body"]</p>
        <a class="kf-join__btn" href="settings#communaute">@F["Join.NeedMember.Link"]</a>
    }
    else
    {
        @if (_outcome is null && ShortOnTime)
        {
            <p class="kf-join__note kf-join__note--warning">@F["Join.ShortWarning"]</p>
        }

        @if (_outcome != JoinSprintOutcome.SprintClosed)
        {
            <button type="button" class="kf-join__btn" disabled="@_busy" aria-busy="@(_busy ? "true" : null)"
                    aria-label="@F.Format("Join.Button.Aria", TargetName)" @onclick="JoinAsync">
                @F[_busy ? "Join.Joining" : "Join.Button"]
            </button>
        }

        @switch (_outcome)
        {
            case JoinSprintOutcome.SprintActive:
                <p class="kf-join__note kf-join__note--error" role="alert">
                    @F["Join.SprintActive"]
                    <a href="pomodoro">@F["Join.SprintActive.Link"]</a>
                </p>
                break;
            case JoinSprintOutcome.OwnSprint:
                <p class="kf-join__note kf-join__note--error" role="alert">@F["Join.OwnSprint"]</p>
                break;
            case JoinSprintOutcome.SprintClosed:
                <p class="kf-join__note kf-join__note--error" role="alert">@F["Join.Closed"]</p>
                break;
            case JoinSprintOutcome.Failed:
                <p class="kf-join__note kf-join__note--error" role="alert">@F["Join.Error"]</p>
                break;
        }
    }
</div>

@code {
    /// <summary>Name of the member whose sprint is joined.</summary>
    [Parameter, EditorRequired] public string TargetName { get; set; } = "";

    /// <summary>End of the sprint: under five minutes left, a warning says it will not earn XP.</summary>
    [Parameter, EditorRequired] public DateTimeOffset EndsAt { get; set; }

    [Parameter] public bool ViewerIsMember { get; set; }

    /// <summary>The sprint was closed, elapsed or finished (410): the parent refreshes its data.</summary>
    [Parameter] public EventCallback OnNoLongerOpen { get; set; }

    private static readonly TimeSpan XpThreshold = TimeSpan.FromMinutes(5);

    private bool _busy;
    private JoinSprintOutcome? _outcome;

    private bool ShortOnTime => EndsAt - Clock.GetUtcNow() < XpThreshold;

    private async Task JoinAsync()
    {
        if (_busy) return;
        _busy = true;
        _outcome = null;

        var result = await Community.JoinSprintAsync(TargetName);

        if (result.Outcome == JoinSprintOutcome.Succeeded)
        {
            // Stays disabled: the page changes.
            Nav.NavigateTo("/pomodoro");
            return;
        }

        _outcome = result.Outcome;
        // A generic failure can be retried; the other outcomes explain why it cannot (or lead elsewhere).
        _busy = result.Outcome == JoinSprintOutcome.SprintActive
            || result.Outcome == JoinSprintOutcome.OwnSprint
            || result.Outcome == JoinSprintOutcome.SprintClosed;

        if (result.Outcome == JoinSprintOutcome.SprintClosed)
            await OnNoLongerOpen.InvokeAsync();
    }
}
